alias HTTP.Headers
alias HTTP.Method
alias HTTP.Request
alias HTTP.Response
alias HTTP.Status
alias JSON.Value

priv fn request(method: Method, target: String) -> Request
  Request{
    body: "",
    headers: Headers.new(),
    method: method,
    path: target,
    version: "HTTP/1.1",
  }
end

struct RouterTest
  priv fn echo_param(name: String) -> fn (Conn) -> Conn
    handler =
      fn (conn: Conn) -> Conn
        conn.text(Status.ok(), conn.param(name).or("missing"))
      end

    handler
  end

  test "routes by method and static path"
    router = Router.new()
      .get(
        "/health",
        fn (conn: Conn) -> Conn conn.text(Status.ok(), "healthy") end,
      )
      .post(
        "/health",
        fn (conn: Conn) -> Conn conn.text(Status.created(), "made health") end,
      )

    response = router.dispatch(request(Method.Get, "/health"))
    assert response.status.code == 200, "GET matches"
    assert response.body == "healthy", "GET body"

    response = router.dispatch(request(Method.Post, "/health"))
    assert response.status.code == 201, "POST matches its own route"

    response = router.dispatch(request(Method.Delete, "/health"))
    assert response.status.code == 404, "unregistered method falls back"

    response = router.dispatch(request(Method.Get, "/absent"))
    assert response.status.code == 404, "unknown path falls back"
  end

  test "binds path parameters"
    router =
      Router.new()
        .get("/sessions/:id", RouterTest.echo_param("id"))
        .get("/a/:x/b/:y", fn (conn: Conn) -> Conn
            text = "#{conn.param("x").or("?")}-#{conn.param("y").or("?")}"
            conn.text(Status.ok(), text)
          end)

    response = router.dispatch(request(Method.Get, "/sessions/abc-123"))
    assert response.body == "abc-123", "single param binds"

    response = router.dispatch(request(Method.Get, "/a/1/b/2"))
    assert response.body == "1-2", "multiple params bind"

    response = router.dispatch(request(Method.Get, "/sessions/abc/extra"))
    assert response.status.code == 404, "extra segment falls back"

    response = router.dispatch(request(Method.Get, "/sessions"))
    assert response.status.code == 404, "missing segment falls back"

    response = router.dispatch(request(Method.Get, "/sessions/abc-123/"))
    assert response.body == "abc-123", "trailing slash tolerated"
  end

  test "first matching route wins"
    router = Router.new()
      .get(
        "/things/special",
        fn (conn: Conn) -> Conn conn.text(Status.ok(), "special") end,
      )
      .get("/things/:id", RouterTest.echo_param("id"))

    response = router.dispatch(request(Method.Get, "/things/special"))
    assert response.body == "special", "static route registered first wins"

    response = router.dispatch(request(Method.Get, "/things/42"))
    assert response.body == "42", "param route still reachable"
  end

  test "middleware runs in order and halt stops the pipeline"
    router =
      Router.new()
        .use(fn (conn: Conn) -> Conn conn.put_resp_header("X-First", "1") end)
        .use(fn (conn: Conn) -> Conn
          match conn.get_header("Authorization")
            Option.Some(_) -> conn
            Option.None ->
              conn.text(Status.unauthorized(), "no credentials").halt()
          end
        end)
        .get(
          "/secret",
          fn (conn: Conn) -> Conn conn.text(Status.ok(), "the secret") end,
        )

    response = router.dispatch(request(Method.Get, "/secret"))
    assert response.status.code == 401, "halted by middleware"
    assert response.body == "no credentials", "middleware response body"
    assert response.headers.get("X-First") == Option.Some("1"),
      "earlier middleware still applied"

    authed = request(Method.Get, "/secret")
    authed.headers = authed.headers.set("Authorization", "Bearer x")
    response = router.dispatch(authed)
    assert response.status.code == 200, "passes with credentials"
    assert response.body == "the secret", "handler ran"
  end

  test "query and path split, query params read"
    router =
      Router.new().get("/items", fn (conn: Conn) -> Conn
            text = "#{conn.query_param("limit").or("none")}/#{conn.query_param("q").or("none")}"
            conn.text(Status.ok(), text)
          end)

    response = router.dispatch(request(Method.Get, "/items?limit=5&q=abc"))
    assert response.body == "5/abc", "query params parse"

    response = router.dispatch(request(Method.Get, "/items"))
    assert response.body == "none/none", "absent query params"
  end

  test "json helper sets body and content headers"
    router = Router.new()
      .get(
        "/data",
        fn (conn: Conn) -> Conn
          conn.json(
            Status.ok(),
            Value.object([Value.entry("ok", Value.bool(true))]),
          )
        end,
      )

    response = router.dispatch(request(Method.Get, "/data"))
    assert response.body == "{\"ok\":true}", "json body"
    assert response.headers.get("Content-Type") == Option.Some("application/json"),
      "content type"
    assert response.headers.get("Content-Length") == Option.Some("11"),
      "content length"
  end

  test "custom fallback and unresponded conns"
    router = Router.new()
      .not_found(fn (conn: Conn) -> Conn
        conn.json(Status.not_found(), Value.string("no route for #{conn.path}"))
      end)
      .get("/forgot", fn (conn: Conn) -> Conn conn end)

    response = router.dispatch(request(Method.Get, "/nowhere"))
    assert response.status.code == 404, "custom fallback status"
    assert response.body == "\"no route for /nowhere\"", "custom fallback body"

    response = router.dispatch(request(Method.Get, "/forgot"))
    assert response.status.code == 500,
      "handler that never responds becomes 500"
  end
end
