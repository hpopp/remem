@doc """
The development format. One line per record with the time, the
level, the message, and then each attribute as `key=value`.

```
2026-09-23T20:00:00.123456Z INFO swept 12 rows job=cleaner
```
"""
struct Text
  @doc """
  The text format as a `Config.format` closure.
  """
  fn formatter -> fn (Record) -> String
    render = fn (record: Record) -> String Text.render(record) end

    render
  end

  @doc """
  Renders one record.
  """
  fn render(record: Record) -> String
    line = "#{record.time()} #{record.level.to_string()} #{record.message}"

    for (key, value) in record.attributes
      line = line <> " #{key}=#{value.to_string()}"
    end

    line
  end
end
