alias Test.require

priv const SPAN_ID: String = "00f067aa0ba902b7"
priv const TRACE_ID: String = "4bf92f3577b34da6a3ce929d0e0e4736"

struct PropagationTest
  priv fn hex(bytes: Binary) -> String
    Base.encode16(bytes)
  end

  # The context a process would carry inside a span that is the
  # parent itself, so `header` writes the parent's own ids back.
  priv fn context(parent: Trace.Parent) -> Process.Context
    Process.Context{
      flags: parent.sampled ? 1 : 0,
      span: parent.span,
      trace_hi: parent.trace_hi,
      trace_lo: parent.trace_lo,
    }
  end

  test "parse reads a sampled traceparent"
    parent = try require(Propagation.parse("00-#{TRACE_ID}-#{SPAN_ID}-01"))

    assert hex(parent.trace_id()) == TRACE_ID
    assert hex(parent.span_id()) == SPAN_ID
    assert parent.trace_id().byte_size() == 16
    assert parent.span_id().byte_size() == 8
    assert parent.sampled
  end

  test "parse reads an unsampled flag"
    parent = try require(Propagation.parse("00-#{TRACE_ID}-#{SPAN_ID}-00"))

    assert not parent.sampled
  end

  test "parse accepts uppercase hex"
    parent = try require(
      Propagation.parse(
        "00-4BF92F3577B34DA6A3CE929D0E0E4736-00F067AA0BA902B7-01",
      ),
    )

    assert hex(parent.trace_id()) == TRACE_ID
    assert hex(parent.span_id()) == SPAN_ID
  end

  test "parse trims surrounding whitespace"
    parent = try require(Propagation.parse(" 00-#{TRACE_ID}-#{SPAN_ID}-01 "))

    assert hex(parent.trace_id()) == TRACE_ID
  end

  test "parse accepts a newer version with extra fields"
    parent = try require(
      Propagation.parse("01-#{TRACE_ID}-#{SPAN_ID}-01-extra"),
    )

    assert hex(parent.trace_id()) == TRACE_ID
    assert parent.sampled
  end

  test "parse rejects a malformed header"
    assert Propagation.parse("") == Result.Err(Propagation.Error.InvalidFormat)
    assert Propagation.parse("garbage") ==
      Result.Err(Propagation.Error.InvalidFormat)
    assert Propagation.parse("0-#{TRACE_ID}-#{SPAN_ID}-01") ==
      Result.Err(Propagation.Error.InvalidFormat)
    assert Propagation.parse("00-#{TRACE_ID}-#{SPAN_ID}-01-extra") ==
      Result.Err(Propagation.Error.InvalidFormat)
  end

  test "parse rejects version ff"
    assert Propagation.parse("ff-#{TRACE_ID}-#{SPAN_ID}-01") ==
      Result.Err(Propagation.Error.UnsupportedVersion)
  end

  test "parse rejects bad identifiers"
    assert Propagation.parse("00-#{SPAN_ID}-#{SPAN_ID}-01") ==
      Result.Err(Propagation.Error.InvalidTraceId)
    assert Propagation.parse(
        "00-00000000000000000000000000000000-#{SPAN_ID}-01",
      ) == Result.Err(Propagation.Error.InvalidTraceId)
    assert Propagation.parse("00-#{TRACE_ID}-0000000000000000-01") ==
      Result.Err(Propagation.Error.InvalidSpanId)
    assert Propagation.parse("00-#{TRACE_ID}-zzf067aa0ba902b7-01") ==
      Result.Err(Propagation.Error.InvalidSpanId)
  end

  test "parse rejects bad flags"
    assert Propagation.parse("00-#{TRACE_ID}-#{SPAN_ID}-1") ==
      Result.Err(Propagation.Error.InvalidFlags)
    assert Propagation.parse("00-#{TRACE_ID}-#{SPAN_ID}-zz") ==
      Result.Err(Propagation.Error.InvalidFlags)
  end

  test "a root under a parsed parent continues its trace"
    parent = try require(Propagation.parse("00-#{TRACE_ID}-#{SPAN_ID}-01"))
    inside = Trace.root(
      "request",
      Trace.RootOptions{parent: Option.Some(parent)},
      span -> Process.context(),
    )
    _ = Trace.Export.pop()

    assert hex(inside.trace_id()) == TRACE_ID
    assert hex(inside.span_id()) != SPAN_ID
    assert inside.sampled?()
  end

  test "a root under a parsed parent carries the unsampled flag"
    parent = try require(Propagation.parse("00-#{TRACE_ID}-#{SPAN_ID}-00"))
    inside = Trace.root(
      "request",
      Trace.RootOptions{parent: Option.Some(parent)},
      span -> Process.context(),
    )

    assert hex(inside.trace_id()) == TRACE_ID
    assert not inside.sampled?()
  end

  test "header round trips through parse"
    original = try require(Propagation.parse("00-#{TRACE_ID}-#{SPAN_ID}-01"))
    header = Propagation.header(context(original))

    assert header == "00-#{TRACE_ID}-#{SPAN_ID}-01"

    parsed = try require(Propagation.parse(header))
    assert parsed == original
  end

  test "header writes the unsampled flag"
    parent = try require(Propagation.parse("00-#{TRACE_ID}-#{SPAN_ID}-00"))

    assert Propagation.header(context(parent)) == "00-#{TRACE_ID}-#{SPAN_ID}-00"
  end

  test "header inside a root names the root span"
    (header, inside) = Trace.root(
      "request",
      span -> (Propagation.header(Trace.current()), Process.context()),
    )
    _ = Trace.Export.pop()

    parsed = try require(Propagation.parse(header))
    assert parsed.trace_id() == inside.trace_id()
    assert parsed.span_id() == inside.span_id()
    assert parsed.sampled
  end
end
