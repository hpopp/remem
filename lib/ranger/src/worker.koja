alias HTTP.Parser
alias HTTP.Request
alias HTTP.Response
alias HTTP.Status
alias Net.TCPSocket
alias Process.Step
alias Process.StopReason

# Bytes pulled per socket read.
priv const READ_CHUNK: Int = 8192

@doc """
A one-shot process that owns a single client connection. Spawn one
per accepted socket:

```
TCPEvent.Connected(client) ->
  _ = spawn Worker.start(Worker{client: client, config: self.config})
```

Its `run` loop reads requests off the socket (HTTP keep-alive),
dispatches each one through the configured handler, and writes the
response, looping on partial writes until every byte is out. The
worker exits when the client closes, a read or write fails, a
request overruns a size cap, the request asks for
`Connection: close`, or the per-connection request budget is spent.
"""
struct Worker: Process<Worker, (), ()>
  client: TCPSocket
  config: Config

  fn start(config: Worker) -> Self ! StopReason
    config
  end

  fn handle(self, msg: (), from: Option<ReplyTo<()>>) -> Step<Self>
    Step.Continue(self)
  end

  # Serves requests iteratively. Keep-alive connections are
  # long-lived, so this must not grow the stack per request.
  fn run(self) -> StopReason
    buffered: Binary = <<>>
    budget = self.config.max_requests_per_connection

    while budget > 0
      match self.read_request(buffered)
        Frame.Incomplete ->
          self.close()
          return StopReason.Normal

        Frame.TooLarge ->
          reject = self.config.on_reject
          reject(Status.new(413, "Payload Too Large"))

          build = self.config.error_response
          response = with_connection(
            build(
              Status.new(413, "Payload Too Large"),
              "request exceeds the #{self.config.max_body_bytes} byte limit",
            ),
            "close",
          )
          _ = write_all(self.client, response.serialize())
          self.close()
          return StopReason.Normal

        Frame.Complete(framed) ->
          (request, leftover) = framed
          (response, keep) = self.respond(request)
          keep = keep and budget > 1
          response = with_connection(response, keep ? "keep-alive" : "close")

          if write_all(self.client, response.serialize()) and keep
            buffered = leftover
            budget = budget - 1
          else
            self.close()
            return StopReason.Normal
          end
      end
    end

    self.close()
    StopReason.Normal
  end

  # Decodes, parses, and dispatches one framed request. Returns the
  # response paired with whether the client wants the connection kept
  # open. Bytes that are not UTF-8 are malformed the same way an
  # unparseable request is.
  priv fn respond(self, raw: Binary) -> (Response, Bool)
    started = Instant.now()

    text =
      match raw.to_string()
        Result.Ok(decoded) -> decoded
        Result.Err(_) -> return self.reject_malformed()
      end

    match Parser.parse_request(text)
      Result.Err(_) ->
        self.reject_malformed()

      Result.Ok(req) ->
        keep = wants_keep_alive?(req)
        handler = self.config.handler
        response = handler(req)

        elapsed = started.elapsed()
        observe = self.config.on_request
        observe(req, response, elapsed)
        (response, keep)
    end
  end

  priv fn reject_malformed(self) -> (Response, Bool)
    reject = self.config.on_reject
    reject(Status.bad_request())

    build = self.config.error_response
    (build(Status.bad_request(), "malformed request"), false)
  end

  # Reads from the client until `buffered` holds one complete HTTP
  # request (headers plus `Content-Length` bytes of body). Returns
  # the framed request paired with any bytes that arrived after it
  # (pipelining). `Incomplete` here means the client closed or the
  # read failed. Iterative because large bodies span many reads and
  # must not grow the stack.
  priv fn read_request(self, buffered: Binary) -> Frame
    buffer = buffered

    loop
      match frame_request(
        buffer,
        self.config.max_header_bytes,
        self.config.max_body_bytes,
      )
        Frame.Complete(framed) ->
          return Frame.Complete(framed)

        Frame.TooLarge ->
          return Frame.TooLarge

        Frame.Incomplete ->
          match self.client.read(READ_CHUNK)
            Result.Ok(chunk) when chunk.byte_size() > 0 ->
              buffer = buffer <> chunk
            _ -> return Frame.Incomplete
          end
      end
    end
  end

  priv fn close(self)
    match self.client.close()
      _ -> ()
    end
  end
end

@doc """
The outcome of framing bytes into one HTTP request. Either a
complete request paired with any pipelined leftover, not enough
bytes yet, or a request over the size caps. The request stays as
bytes until the worker decodes it, so a body that is not UTF-8
reaches the worker instead of failing a read.
"""
enum Frame
  Complete((Binary, Binary))
  Incomplete
  TooLarge
end

@doc """
Splits `buffer` into one complete request and the leftover bytes.
`Incomplete` asks the caller to read more, `TooLarge` means the
headers overran `max_header_bytes` or the declared body overran
`max_body_bytes`. Content-Length is a byte count, so framing works
on bytes and the split lands exactly where the body ends.
"""
fn frame_request(buffer: Binary, max_header_bytes: Int, max_body_bytes: Int)
  -> Frame

  header_end =
    match buffer.find(<<13, 10, 13, 10>>, 0)
      Option.Some(index) ->
        index

      Option.None ->
        # Headers still incomplete. A buffer already past the header
        # cap can never complete them.
        return buffer.byte_size() > max_header_bytes
          ? Frame.TooLarge
          : Frame.Incomplete
    end

  length = content_length(buffer.slice(Range{start: 0, stop: header_end - 1}))

  if header_end > max_header_bytes or length > max_body_bytes
    return Frame.TooLarge
  end

  total = header_end + 4 + length
  size = buffer.byte_size()

  if size < total
    return Frame.Incomplete
  end

  if size == total
    return Frame.Complete((buffer, <<>>))
  end

  request = buffer.slice(Range{start: 0, stop: total - 1})
  leftover = buffer.slice(Range{start: total, stop: size - 1})
  Frame.Complete((request, leftover))
end

# Reads the Content-Length header out of the header bytes. Headers
# that do not decode, or carry no usable value, count as zero, and
# the decode in `respond` then reports the request as malformed.
priv fn content_length(header_bytes: Binary) -> Int
  header_text =
    match header_bytes.to_string()
      Result.Ok(text) -> text
      Result.Err(_) -> return 0
    end

  lines = header_text.split("\r\n")
  found = lines.filter(line -> line.downcase().starts_with?("content-length:"))

  match found.get(0)
    Option.None ->
      0

    Option.Some(line) ->
      match line.split(":").get(1)
        Option.None ->
          0

        Option.Some(value) ->
          match value.trim().to_int()
            Result.Ok(n) -> n
            Result.Err(_) -> 0
          end
      end
  end
end

# HTTP/1.1 defaults to keep-alive and HTTP/1.0 to close, but an
# explicit Connection header overrides either.
priv fn wants_keep_alive?(req: Request) -> Bool
  fallback = req.version == "HTTP/1.1"

  match req.headers.get("Connection")
    Option.None ->
      fallback

    Option.Some(value) ->
      lowered = value.downcase()

      cond
        lowered.contains?("close") -> false
        lowered.contains?("keep-alive") -> true
        else -> fallback
      end
  end
end

priv fn with_connection(response: Response, value: String) -> Response
  response.headers = response.headers.set("Connection", value)
  response
end

# Writes the whole response, looping on partial writes. One
# `TCPSocket.write` call is a single write(2), which sends only part
# of a large response once the socket buffer fills. Returns false
# when the client is gone.
priv fn write_all(client: TCPSocket, data: String) -> Bool
  bytes = data.to_binary()
  total = bytes.byte_size()
  sent = 0

  while sent < total
    chunk = bytes.slice(Range{start: sent, stop: total - 1})
    written = client.write(chunk) rescue _ -> -1

    if written <= 0
      return false
    end

    sent = sent + written
  end

  true
end
