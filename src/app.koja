alias Conn.Conn
alias Conn.Router
alias HTTP.Method
alias HTTP.Request
alias HTTP.Response
alias HTTP.Status
alias Log.Attribute as LogAttribute
alias Log.Config as LogConfig
alias Log.GCP
alias Log.Logger
alias Log.Text
alias Net.TCPServer
alias Net.TCPServer.Config as TCPServerConfig
alias Net.TCPServer.Event as TCPEvent
alias OpenTelemetry.Attribute
alias OpenTelemetry.Config as TracerConfig
alias OpenTelemetry.Outcome
alias OpenTelemetry.Propagation
alias OpenTelemetry.SpanContext
alias OpenTelemetry.SpanKind
alias OpenTelemetry.Status as SpanStatus
alias OpenTelemetry.Tracer
alias Pooler.Config as PoolConfig
alias Pooler.Pool
alias Postgres.Config as DbConfig
alias Postgres.Connection
alias Process.Lifecycle
alias Process.Step
alias Process.StopReason
alias Trail.Config as TrailConfig
alias Trail.Worker

const VERSION: String = "0.5.0"

const POOL_SIZE: Int = 10

# SCRAM auth costs ~1s per connect under the interpreter, and the
# startup probe waits for the whole pool, so give it a generous budget.
const STARTUP_PROBE_MS: Int = 30000

# How often the search log sweeper ticks.
priv const SWEEP_INTERVAL_MS: Int = 3600000

# How often the embedding backfill looks for unembedded observations
# once the backlog is drained.
priv const BACKFILL_INTERVAL_MS: Int = 60000

@doc """
The remem entry process. `start` loads config from the environment,
builds the logger, runs schema migrations on a dedicated connection,
spawns a pool of `POOL_SIZE` Postgres connections, builds the route
table once, starts the tracer, the search log sweeper, and the
embedding backfill, and spawns a `Net.TCPServer` acceptor that
delivers connected sockets as `TCPEvent.Connected` messages. Each
connection is handed to a one-shot `Trail.Worker`, so requests are
handled concurrently and the entry process never blocks on IO.
"""
struct App: Process<List<String>, TCPEvent, String>
  log: Logger
  server: TrailConfig

  fn start(config: List<String>) -> Self ! StopReason
    settings = Config.load()
    log = build_logger(settings)
    database = settings.database
    db_config = DbConfig.new(
      database.host,
      database.port,
      database.user,
      database.name,
    )
      .with_password(database.password)
      .with_statement_cache_size(database.statement_cache)

    try migrate(db_config, log)

    create =
      fn () -> Result<Connection, String>
        Connection.connect(db_config).map_err(e -> e.message())
      end

    # The pool drops any connection that comes back closed or stuck in
    # a transaction and refills the slot, so a database restart heals
    # instead of leaving broken sockets on the shelf.
    pool = Pool.start(
      PoolConfig{
        create: create,
        size: POOL_SIZE,
        valid: Option.Some(fn (conn: Connection) -> Bool conn.idle?() end),
      },
    )

    # The pool builds its connections eagerly but reports factory
    # failure as PoolDown on first use. Probe once so a bad database
    # config fails at startup instead of on the first request.
    match pool.checkout(STARTUP_PROBE_MS)
      Result.Ok(conn) ->
        pool.checkin(conn)

      Result.Err(Pooler.Error.Timeout) ->
        log.error(
          "database connections are still warming up, try again shortly",
        )
        fail StopReason.Shutdown

      Result.Err(_) ->
        log.error("database connection failed (is the compose stack up?)")
        fail StopReason.Shutdown
    end

    tracer = Tracer.start(
      TracerConfig{
        endpoint: settings.tracing.endpoint,
        service_name: settings.tracing.service_name,
        service_version: Option.Some(VERSION),
      },
    )

    embedder = Embedder{log: log, url: settings.embedding_url}
    router = build_router(pool, embedder, settings.api_key, tracer, log)

    _cleaner = spawn Cleaner.start(
      Cleaner.Config{interval_ms: SWEEP_INTERVAL_MS, log: log, pool: pool},
    )

    _backfill = spawn Backfill.start(
      Backfill.Config{
        embedder: embedder,
        interval_ms: BACKFILL_INTERVAL_MS,
        log: log,
        pool: pool,
      },
    )

    me: Ref<TCPEvent, String> = Ref.self_ref()
    _server = spawn TCPServer.start(
      TCPServerConfig{port: settings.port, owner: me},
    )

    auth = settings.api_key.some?() ? "required" : "off"
    tracing = settings.tracing.endpoint.or("off")
    log.info("remem #{VERSION} listening on http://127.0.0.1:#{settings.port}")
    log.info("embedding server: #{settings.embedding_url}")
    log.info("api key auth: #{auth}, #{POOL_SIZE} pooled db connections")
    log.info("trace export: #{tracing}")

    App{log: log, server: server_config(router, tracer, log)}
  end

  fn handle(self, msg: TCPEvent, from: Option<ReplyTo<String>>) -> Step<Self>
    match msg
      TCPEvent.Connected(client) ->
        _ = spawn Worker.start(Worker{client: client, config: self.server})
        Step.Continue(self)

      TCPEvent.Closed(_) ->
        Step.Continue(self)

      TCPEvent.Error(e) ->
        self.log.error("listener error: " <> e.message())
        Step.Done(StopReason.Shutdown)
    end
  end

  fn handle_signal(self, signal: Lifecycle) -> Step<Self>
    match signal
      Lifecycle.Interrupt ->
        IO.puts("")
        self.log.info("received SIGINT, shutting down...")
        Step.Done(StopReason.Normal)

      Lifecycle.Reload ->
        Step.Continue(self)

      Lifecycle.Shutdown ->
        self.log.info("received SIGTERM, shutting down...")
        Step.Done(StopReason.Shutdown)
    end
  end

  # Runs pending migrations on a dedicated connection, closed after.
  priv fn migrate(db_config: DbConfig, log: Logger) ! StopReason
    conn =
      match Connection.connect(db_config)
        Result.Err(e) ->
          log.error("migration connect failed: " <> e.message())
          fail StopReason.Shutdown

        Result.Ok(connected) ->
          connected
      end

    match Migrator.run(conn)
      Result.Ok(migrated) ->
        _ = migrated.close()

      Result.Err(e) ->
        log.error("migration failed: " <> e.message())
        fail StopReason.Shutdown
    end
  end
end

# Picks the log format from the settings. A `GCP_PROJECT_ID` means
# the service runs on GKE, where the logging agent reads Cloud
# Logging JSON. Without one, lines are text for a terminal.
priv fn build_logger(settings: Config) -> Logger
  formatter =
    match settings.gcp
      Option.Some(gcp) ->
        GCP.formatter(
          GCP.Config{
            project_id: gcp.project_id,
            service_name: gcp.service_name,
            service_version: VERSION,
          },
        )

      Option.None ->
        Text.formatter()
    end

  Logger.new(LogConfig{formatter: formatter, level: settings.log_level})
end

# Wires the route table and remem's logging and error shape into a
# trail worker config. Every dispatched request runs inside a server
# span that continues the caller's trace when it sent a `traceparent`
# header, and the response carries the span's own `traceparent` so a
# client can find its trace. Rejected requests render the same JSON
# error body as routed failures, and every dispatched request logs
# one access line with the trace id in front when tracing is on. The
# line carries the method, path, status, and duration as attributes,
# which the GCP format folds into `httpRequest`. Successful health
# probes are the exception, since they arrive every few seconds and
# would drown both the log and the trace store.
priv fn server_config(router: Router, tracer: Tracer, log: Logger)
  -> TrailConfig

  handler =
    fn (request: Request) -> Response
      if health_probe?(request)
        return router.dispatch(request)
      end

      traced_dispatch(router, tracer, request)
    end

  error_response =
    fn (status: Status, message: String) -> Response
      Render.raw(status, message)
    end

  on_request =
    fn (request: Request, response: Response, elapsed: Duration)
      if health_probe?(request) and response.status.ok?()
        return
      end

      prefix = tracer.enabled?() ? trace_prefix(response) : ""
      method = request.method.to_string()
      code = response.status.code

      log.info(
        "#{prefix}#{method} #{request.path} #{code} #{Log.elapsed(elapsed)}",
        [
          "http.request.method": LogAttribute.from(method),
          "url.path": LogAttribute.from(request.path),
          "http.response.status_code": LogAttribute.from(code),
          "http.server.request.duration": LogAttribute.from(
            elapsed.to_microseconds(),
          )
        ],
      )
    end

  on_reject =
    fn (status: Status)
      match status.code
        400 -> log.warn("unparseable request 400")
        413 -> log.warn("oversized request 413")
        _ -> log.warn("rejected request #{status.code}")
      end
    end

  TrailConfig.new(handler)
    .with_error_response(error_response)
    .with_on_request(on_request)
    .with_on_reject(on_reject)
end

# Runs the router inside a server span. The span records the method,
# path, and status code, and a 5xx marks it as an error. The conn
# carries the span so handlers open their children under it.
priv fn traced_dispatch(router: Router, tracer: Tracer, request: Request)
  -> Response

  method = request.method.to_string()
  parent = request.headers.get(Propagation.HEADER)
    .then(header -> Propagation.parse(header).ok())
  attributes: Map<String, Attribute> = [
    "http.request.method": Attribute.from(method),
    "url.path": Attribute.from(request.path)
  ]

  work =
    fn (ctx: SpanContext) -> (Response, Outcome)
      conn = Trace.put(Conn.from_request(request), ctx)
      response = router.dispatch_conn(conn)
      code = response.status.code
      response.headers = response.headers.set(
        Propagation.HEADER,
        Propagation.header(ctx),
      )

      outcome = Outcome{
        attributes: ["http.response.status_code": Attribute.from(code)],
        status: code >= 500
          ? SpanStatus.Error("HTTP #{code}")
          : SpanStatus.Unset,
      }

      (response, outcome)
    end

  tracer.span_with(
    "#{method} #{request.path}",
    SpanKind.Server,
    parent,
    attributes,
    work,
  )
end

# The trace id from the `traceparent` the server span put on the
# response, ready to lead an access log line.
priv fn trace_prefix(response: Response) -> String
  response.headers.get(Propagation.HEADER)
    .then(header -> Propagation.parse(header).ok())
    .map(ctx -> "#{ctx.trace_id} ")
    .or("")
end

# True for a `GET /health`. Probes are neither traced nor, when they
# pass, logged. A failed probe still logs so a sick database shows up.
priv fn health_probe?(request: Request) -> Bool
  request.method == Method.Get and request.path == "/health"
end
