alias Log.Logger
alias Pooler.Pool
alias Postgres.Connection
alias Process.Step
alias Process.StopReason

# Observations embedded per pass. Matches the embedder's request
# batch, so one pass is one call to the embedding server.
priv const BACKFILL_BATCH: Int = 32

# Pause between passes while draining a backlog. Long enough for
# request traffic to interleave, short enough to drain quickly.
priv const BACKFILL_DRAIN_MS: Int = 100

# Checkout budget for a pass. A busy pool skips the pass instead of
# queueing behind request traffic.
priv const BACKFILL_CHECKOUT_MS: Int = 1000

struct Backfill.Config
  embedder: Embedder
  interval_ms: Int
  log: Logger
  pool: Pool<Connection>
end

@doc """
The background embedder. Ticks on its own timer and embeds
observations and events whose `embedding` is NULL, `BACKFILL_BATCH`
rows at a time, observations first and events with whatever budget
remains. Rows arrive there three ways: the migration that added the
column, a write whose embedding call failed, and a merge or rename
that changed the entity name in the embedding text. The first tick
is immediate so a fresh deploy catches up within a minute, and a
full batch schedules the next pass after a short pause instead of
the whole interval.
"""
struct Backfill: Process<Backfill.Config, (), ()>
  embedder: Embedder
  interval_ms: Int
  log: Logger
  pool: Pool<Connection>

  fn start(config: Backfill.Config) -> Self ! StopReason
    me: Ref<(), ()> = Ref.self_ref()
    me.send_after((), 0)
    Backfill{
      embedder: config.embedder,
      interval_ms: config.interval_ms,
      log: config.log,
      pool: config.pool,
    }
  end

  fn handle(self, msg: (), from: Option<ReplyTo<()>>) -> Step<Self>
    (observations, events) = self.pass()
    embedded = observations + events

    cond
      events > 0 ->
        self.log.info(
          "embedded #{observations} observations and #{events} events",
        )

      observations > 0 ->
        self.log.info("embedded #{observations} observations")

      else ->
        ()
    end

    delay = embedded >= BACKFILL_BATCH ? BACKFILL_DRAIN_MS : self.interval_ms
    me: Ref<(), ()> = Ref.self_ref()
    me.send_after((), delay)
    Step.Continue(self)
  end

  # Embeds one batch and returns how many observation and event rows
  # were updated. Failures log and count as zero, so the next pass
  # waits the full interval.
  priv fn pass(self) -> (Int, Int)
    match self.pool.checkout(BACKFILL_CHECKOUT_MS)
      Result.Err(_) ->
        (0, 0)

      Result.Ok(db) ->
        (db, observations) = embed_pending(db, self.embedder, self.log)
        remaining = BACKFILL_BATCH - observations
        (db, events) = remaining > 0
          ? embed_pending_events(db, self.embedder, self.log, remaining)
          : (db, 0)
        self.pool.checkin(db)
        (observations, events)
    end
  end
end

priv fn embed_pending(db: Connection, embedder: Embedder, log: Logger)
  -> (Connection, Int)

  (db, pending) = EntityStore.unembedded(db, BACKFILL_BATCH)

  # A failed read logs and reads as nothing pending.
  rows = pending
    rescue e -> warn_and(log, "embedding backfill: " <> e.message(), List.new())

  if rows.empty?()
    return (db, 0)
  end

  ids = rows.map(row -> row.id)
  texts = rows.map(row -> embedding_text(row.name, row.kind, row.content))

  (db, outcome) = embed_texts(db, embedder, ids, texts)
  (
    db,
    outcome rescue e -> warn_and(log, "embedding backfill: " <> e.message(), 0)
  )
end

priv fn embed_pending_events(
  db: Connection,
  embedder: Embedder,
  log: Logger,
  limit: Int,
) -> (Connection, Int)

  (db, pending) = EventStore.unembedded(db, limit)

  rows = pending
    rescue e -> warn_and(
      log,
      "event embedding backfill: " <> e.message(),
      List.new(),
    )

  if rows.empty?()
    return (db, 0)
  end

  ids = rows.map(row -> row.id)
  texts = rows.map(row -> event_text(
    row.name,
    row.kind,
    row.occurred_at,
    row.content,
  ))

  (db, outcome) = embed_event_texts(db, embedder, ids, texts)

  (
    db,
    outcome
      rescue e -> warn_and(log, "event embedding backfill: " <> e.message(), 0)
  )
end
