alias Conn.Conn
alias HTTP.Status
alias JSON.Value as Json
alias Pooler.Pool
alias Postgres.Connection

@doc """
Entity endpoints. Holds exactly the dependencies these handlers use,
captured when the router is built. Each handler parses and validates
before touching the pool, runs its database phase through `with_db`
(which always checks the connection back in), and renders one
response at the surface.
"""
struct EntityController
  embedder: Embedder
  pool: Pool<Connection>
  trace: Trace

  fn list(self, c: Conn) -> Conn
    self.do_list(c) rescue e -> Render.from_error(c, e)
  end

  fn show(self, c: Conn) -> Conn
    self.do_show(c) rescue e -> Render.from_error(c, e)
  end

  fn create(self, c: Conn) -> Conn
    self.do_create(c) rescue e -> Render.from_error(c, e)
  end

  fn rename(self, c: Conn) -> Conn
    self.do_rename(c) rescue e -> Render.from_error(c, e)
  end

  fn merge(self, c: Conn) -> Conn
    self.do_merge(c) rescue e -> Render.from_error(c, e)
  end

  fn delete(self, c: Conn) -> Conn
    self.do_delete(c) rescue e -> Render.from_error(c, e)
  end

  fn add_observations(self, c: Conn) -> Conn
    self.do_add_observations(c) rescue e -> Render.from_error(c, e)
  end

  fn remove_observations(self, c: Conn) -> Conn
    self.do_remove_observations(c) rescue e -> Render.from_error(c, e)
  end

  priv fn do_list(self, c: Conn) -> Conn ! Error
    (limit, offset) = try Params.page(c)
    summaries = try with_db(
      self.pool,
      self.trace.at(c),
      db -> EntityStore.summaries(db, limit, offset),
    )

    body: Json = ["entities": Json.Array(summaries.map(s -> s.to_json()))]
    Render.json(c, Status.ok(), body)
  end

  priv fn do_show(self, c: Conn) -> Conn ! Error
    name = try Params.name(c)
    (entity, relations) = try with_db(
      self.pool,
      self.trace.at(c),
      db -> show_db(db, name),
    )

    body: Json = [
      "entity": entity.to_json(),
      "relations": Json.Array(relations.map(r -> r.to_json()))
    ]
    Render.json(c, Status.ok(), body)
  end

  priv fn do_create(self, c: Conn) -> Conn ! Error
    (name, kind, observations) = try JsonUtil.parse_entity(c.body)
    observations = JsonUtil.distinct(observations)
    confirm = JsonUtil.parse_confirm(c.body)
    embedder = self.embedder.with_trace(self.trace.at(c))

    entity = try with_db(
      self.pool,
      self.trace.at(c),
      db -> create_db(db, embedder, name, kind, observations, confirm),
    )
    Render.json(c, Status.created(), entity)
  end

  priv fn do_rename(self, c: Conn) -> Conn ! Error
    name = try Params.name(c)
    new_name = try JsonUtil.parse_string_field(c.body, "name")

    entity = try with_db(
      self.pool,
      self.trace.at(c),
      db -> rename_db(db, name, new_name),
    )
    Render.json(c, Status.ok(), entity)
  end

  priv fn do_merge(self, c: Conn) -> Conn ! Error
    source = try Params.name(c)
    into = try JsonUtil.parse_string_field(c.body, "into")

    entity = try with_db(
      self.pool,
      self.trace.at(c),
      db -> EntityStore.merge(db, source, into),
    )
    Render.json(c, Status.ok(), entity)
  end

  priv fn do_delete(self, c: Conn) -> Conn ! Error
    name = try Params.name(c)
    deleted = try with_db(
      self.pool,
      self.trace.at(c),
      db -> EntityStore.remove(db, name),
    )

    if not deleted
      fail Error.NotFound("no entity named #{name}")
    end

    Render.no_content(c)
  end

  priv fn do_add_observations(self, c: Conn) -> Conn ! Error
    name = try Params.name(c)
    observations = JsonUtil.distinct(try JsonUtil.parse_observations(c.body))
    embedder = self.embedder.with_trace(self.trace.at(c))

    entity = try with_db(
      self.pool,
      self.trace.at(c),
      db -> add_db(db, embedder, name, observations),
    )
    Render.json(c, Status.ok(), entity)
  end

  priv fn do_remove_observations(self, c: Conn) -> Conn ! Error
    name = try Params.name(c)
    observations = JsonUtil.distinct(try JsonUtil.parse_observations(c.body))

    entity = try with_db(
      self.pool,
      self.trace.at(c),
      db -> remove_db(db, name, observations),
    )
    Render.json(c, Status.ok(), entity)
  end
end

# Reads one entity with its relations. A missing entity surfaces as
# `NotFound` so the handler renders a 404.
priv fn show_db(db: Connection, name: String)
  -> (Connection, Result<(Entity, List<Relation>), Error>)

  (db, found) = EntityStore.find(db, name)

  entity =
    match found
      Result.Err(e) ->
        return (db, Result.Err(e))

      Result.Ok(maybe) ->
        match maybe
          Option.None ->
            return (db, Result.Err(Error.NotFound("no entity named #{name}")))
          Option.Some(present) -> present
        end
    end

  (db, relations) = RelationStore.for_entity(db, name)

  match relations
    Result.Err(e) -> (db, Result.Err(e))
    Result.Ok(list) -> (db, Result.Ok((entity, list)))
  end
end

# Creates an entity, then embeds its observations best-effort.
priv fn create_db(
  db: Connection,
  embedder: Embedder,
  name: String,
  kind: String,
  observations: List<String>,
  confirm: Bool,
) -> (Connection, Result<Entity, Error>)

  (db, created) = EntityStore.create(db, name, kind, observations, confirm)

  match created
    Result.Err(e) ->
      (db, Result.Err(e))

    Result.Ok(pair) ->
      (entity, rows) = pair
      db = embed_rows(db, embedder, entity, rows)
      (db, Result.Ok(entity))
  end
end

# Renames an entity. A missing entity surfaces as `NotFound`.
priv fn rename_db(db: Connection, name: String, new_name: String)
  -> (Connection, Result<Entity, Error>)

  (db, renamed) = EntityStore.rename(db, name, new_name)

  match renamed
    Result.Err(e) ->
      (db, Result.Err(e))

    Result.Ok(maybe) ->
      match maybe
        Option.None ->
          (db, Result.Err(Error.NotFound("no entity named #{name}")))
        Option.Some(entity) -> (db, Result.Ok(entity))
      end
  end
end

# Adds observations, then embeds the new rows best-effort. A missing
# entity surfaces as `NotFound`.
priv fn add_db(
  db: Connection,
  embedder: Embedder,
  name: String,
  observations: List<String>,
) -> (Connection, Result<Entity, Error>)

  (db, updated) = EntityStore.add_observations(db, name, observations)

  match updated
    Result.Err(e) ->
      (db, Result.Err(e))

    Result.Ok(maybe) ->
      match maybe
        Option.None ->
          (db, Result.Err(Error.NotFound("no entity named #{name}")))

        Option.Some(pair) ->
          (entity, rows) = pair
          db = embed_rows(db, embedder, entity, rows)
          (db, Result.Ok(entity))
      end
  end
end

# Removes observations. Their embeddings go with the rows, so there
# is nothing to recompute. A missing entity surfaces as `NotFound`.
priv fn remove_db(db: Connection, name: String, observations: List<String>)
  -> (Connection, Result<Entity, Error>)

  (db, updated) = EntityStore.remove_observations(db, name, observations)

  match updated
    Result.Err(e) ->
      (db, Result.Err(e))

    Result.Ok(maybe) ->
      match maybe
        Option.None ->
          (db, Result.Err(Error.NotFound("no entity named #{name}")))
        Option.Some(entity) -> (db, Result.Ok(entity))
      end
  end
end
