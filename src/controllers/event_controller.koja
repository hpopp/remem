alias Trail.Conn
alias HTTP.Status
alias JSON.Value as JSONValue
alias Pooler.Pool
alias Postgres.Connection

@doc """
Event endpoints, in the same shape as `EntityController`. Parse and
validate before touching the pool, run the database phase through
`Database.with_connection`, and render one response at the surface.
"""
struct EventController
  embedder: Embedder
  pool: Pool<Connection>

  @doc """
  Fetch the recent events of an entity.
  """
  fn list(self, c: Conn) -> Conn
    self.do_list(c) rescue e -> Render.from_error(c, e)
  end

  @doc """
  Create an event for an entity.
  """
  fn create(self, c: Conn) -> Conn
    self.do_create(c) rescue e -> Render.from_error(c, e)
  end

  @doc """
  Delete an event.
  """
  fn delete(self, c: Conn) -> Conn
    self.do_delete(c) rescue e -> Render.from_error(c, e)
  end

  priv fn do_list(self, c: Conn) -> Conn ! Error
    name = Params.name(c)
    limit = try Params.limit(c, EventStore.RECENT_EVENTS)

    events = try Database.with_connection(
      self.pool,
      db -> recent_db(db, name, limit),
    )

    body: JSONValue = ["events": JSONValue.Array(events.map(e -> e.to_json()))]
    Render.json(c, Status.ok(), body)
  end

  priv fn do_create(self, c: Conn) -> Conn ! Error
    name = Params.name(c)
    (content, occurred_at) = try JsonUtil.parse_event(c.body)
    embedder = self.embedder

    event = try Database.with_connection(
      self.pool,
      db -> add_db(db, embedder, name, content, occurred_at),
    )
    Render.json(c, Status.created(), event)
  end

  priv fn do_delete(self, c: Conn) -> Conn ! Error
    id = try Params.id(c)
    deleted = try Database.with_connection(
      self.pool,
      db -> EventStore.remove(db, id),
    )

    if not deleted
      fail Error.NotFound("no event with id #{id}")
    end

    Render.no_content(c)
  end
end

# Reads an entity's recent events. A missing entity surfaces as
# `NotFound`.
priv fn recent_db(db: Connection, name: String, limit: Int)
  -> (Connection, Result<List<Event>, Error>)

  (db, found) = EventStore.recent(db, name, limit)
  (db, EntityStore.required(found, name))
end

# Records an event, then embeds it best-effort. A missing entity
# surfaces as `NotFound`.
priv fn add_db(
  db: Connection,
  embedder: Embedder,
  name: String,
  content: String,
  occurred_at: Option<DateTime>,
) -> (Connection, Result<Event, Error>)

  (db, added) = EventStore.add(db, name, content, occurred_at)

  match EntityStore.required(added, name)
    Result.Err(e) ->
      (db, Result.Err(e))

    Result.Ok(pair) ->
      (event, entity) = pair
      db = Embedding.embed_event(db, embedder, entity, event)
      (db, Result.Ok(event))
  end
end
