alias Conn.Conn
alias HTTP.Response
alias HTTP.Status
alias JSON.Value as Json
alias Log.Logger
alias Pooler.Pool
alias Postgres.Connection

@doc """
Service endpoints for liveness, the whole graph, and the MCP
JSON-RPC endpoint. Liveness only reports that the server is up. A
database outage surfaces on the routes that use the database, and a
restart would not repair it.
"""
struct MetaController
  embedder: Embedder
  log: Logger
  pool: Pool<Connection>
  trace: Trace

  fn health(self, c: Conn) -> Conn
    body: Json = ["status": "ok".to_json()]
    Render.json(c, Status.ok(), body)
  end

  fn graph(self, c: Conn) -> Conn
    self.do_graph(c) rescue e -> Render.from_error(c, e)
  end

  fn mcp(self, c: Conn) -> Conn
    self.do_mcp(c) rescue e -> Render.from_error(c, e)
  end

  fn mcp_stream_rejected(self, c: Conn) -> Conn
    Render.failure(
      c,
      Status.method_not_allowed(),
      "no SSE stream, POST JSON-RPC messages to /mcp",
    )
  end

  priv fn do_graph(self, c: Conn) -> Conn ! Error
    (entities, relations) = try with_db(
      self.pool,
      self.trace.at(c),
      db -> graph_db(db),
    )

    body: Json = [
      "entities": Json.Array(entities.map(e -> e.to_json())),
      "relations": Json.Array(relations.map(r -> r.to_json()))
    ]
    Render.json(c, Status.ok(), body)
  end

  priv fn do_mcp(self, c: Conn) -> Conn ! Error
    trace = self.trace.at(c)
    embedder = self.embedder.with_trace(trace)
    body = c.body
    log = self.log
    response = try with_db(
      self.pool,
      trace,
      db -> mcp_db(db, embedder, body, trace, log),
    )
    Render.http(c, response)
  end
end

# Reads every entity and relation for `GET /graph`.
priv fn graph_db(db: Connection)
  -> (Connection, Result<(List<Entity>, List<Relation>), Error>)

  (db, entities) = EntityStore.all(db)

  entity_list =
    match entities
      Result.Err(e) -> return (db, Result.Err(e))
      Result.Ok(list) -> list
    end

  (db, relations) = RelationStore.all(db)

  match relations
    Result.Err(e) -> (db, Result.Err(e))
    Result.Ok(list) -> (db, Result.Ok((entity_list, list)))
  end
end

# Runs one MCP message. `Mcp.handle` renders JSON-RPC level errors
# itself, so the outcome only fails when the pool does.
priv fn mcp_db(
  db: Connection,
  embedder: Embedder,
  body: String,
  trace: Trace,
  log: Logger,
) -> (Connection, Result<Response, Error>)

  (response, db) = Mcp.handle(body, db, embedder, trace, log)
  (db, Result.Ok(response))
end
