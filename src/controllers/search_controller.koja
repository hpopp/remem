alias Trail.Conn
alias HTTP.Status
alias JSON.Value as JSONValue
alias Pooler.Pool
alias Postgres.Connection

@doc """
The hybrid search endpoint. Semantic ranking over observations merges
with fuzzy entity name matching, grouped by entity. An unreachable
embedder degrades to fuzzy-only ranking instead of failing the
search.
"""
struct SearchController
  embedder: Embedder
  pool: Pool<Connection>

  @doc """
  The number of results `GET /search` returns when the request sets
  no `limit`.
  """
  const DEFAULT_LIMIT: Int = 10

  @doc """
  The largest `limit` that `GET /search` accepts.
  """
  const MAX_LIMIT: Int = 100

  @doc """
  Search for entities that match the `q` query parameter.
  """
  fn search(self, c: Conn) -> Conn
    self.do_search(c) rescue e -> Render.from_error(c, e)
  end

  priv fn do_search(self, c: Conn) -> Conn ! Error
    q =
      match c.query_param("q")
        Option.Some(text) when not text.empty?() -> text
        _ -> fail Error.Validation("q is required")
      end

    limit = try Params.int(c, "limit", SearchController.DEFAULT_LIMIT)

    if limit < 1 or limit > SearchController.MAX_LIMIT
      fail Error.Validation("limit must be between 1 and #{SearchController.MAX_LIMIT}")
    end

    embedder = self.embedder
    results = try Database.with_connection(
      self.pool,
      db -> search_db(db, embedder, q, limit),
    )

    body: JSONValue = [
      "query": q.to_json(),
      "results": JSONValue.Array(results.map(r -> r.to_json()))
    ]
    Render.json(c, Status.ok(), body)
  end
end

# Logs the query, embeds it, and runs the hybrid search. The log is
# bookkeeping and the embedder is best-effort, so neither failure
# fails the search.
priv fn search_db(db: Connection, embedder: Embedder, q: String, limit: Int)
  -> (Connection, Result<List<SearchResult>, Error>)

  (db, logged) = SearchLog.record(db, q)
  logged rescue e -> Log.warn("Search log write failed. #{e.message()}")

  embedding =
    match embedder.embed(q)
      Result.Ok(vector) ->
        Option.Some(vector)

      Result.Err(e) ->
        Log.warn(
          "Embedding failed, search falls back to fuzzy ranking. #{e.message()}",
        )
        Option.None
    end

  EntityStore.search(db, q, embedding, limit)
end
