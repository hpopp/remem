alias Pooler.Config as PoolConfig
alias Pooler.Pool
alias Postgres.Config as DbConfig
alias Postgres.Connection
alias Process.StopReason

const POOL_SIZE: Int = 10

@doc """
Brings the database up for the entry process. `start` runs pending
migrations on a dedicated connection, then spawns a pool of
`POOL_SIZE` connections. A migration failure is logged and fails with
`StopReason.Shutdown`, which stops the entry process. The pool builds
its connections in the background and keeps retrying while the
database is unreachable, so requests see 503 until it is up rather
than the service exiting.
"""
struct Database
  fn start(settings: Config.Database) -> Pool<Connection> ! StopReason
    db_config = connection_config(settings)
    try migrate(db_config)

    create =
      fn () -> Result<Connection, String>
        Connection.connect(db_config).map_err(e -> e.message())
      end

    # The pool closes and replaces any connection that comes back
    # closed or stuck in a transaction, so a database restart heals
    # instead of leaving broken sockets on the shelf.
    pool_config = PoolConfig{
      create: create,
      destroy: Option.Some(fn (conn: Connection) -> () _ = conn.close() end),
      size: POOL_SIZE,
      valid: Option.Some(fn (conn: Connection) -> Bool conn.idle?() end),
    }

    match Pool.start(pool_config)
      Result.Ok(pool) ->
        pool

      Result.Err(Pooler.Error.InvalidConfig(detail)) ->
        Log.error("Database pool config is invalid. #{detail}")
        fail StopReason.Shutdown

      Result.Err(_) ->
        fail StopReason.Shutdown
    end
  end

  priv fn connection_config(settings: Config.Database) -> DbConfig
    DbConfig.new(settings.host, settings.port, settings.user, settings.name)
      .with_password(settings.password)
      .with_statement_cache_size(settings.statement_cache)
  end

  # Runs pending migrations on a dedicated connection, closed after.
  priv fn migrate(db_config: DbConfig) ! StopReason
    conn =
      match Connection.connect(db_config)
        Result.Err(e) ->
          Log.error(
            "Migration could not connect to the database. #{e.message()}",
          )
          fail StopReason.Shutdown

        Result.Ok(connected) ->
          connected
      end

    match Migrator.run(conn)
      Result.Ok(migrated) ->
        _ = migrated.close()

      Result.Err(e) ->
        Log.error("Migration failed. #{e.message()}")
        fail StopReason.Shutdown
    end
  end
end
