@doc """
The embedding steps that the REST handlers, the MCP tools, and the
backfill share. The functions compose the text to embed, call the
`Embedder`, and store the vectors through `EntityStore` and
`EventStore`.
"""
struct Embedding
  @doc """
  Compose the text one observation embeds under. The entity name and
  type lead so the entity stays part of the cue.
  """
  fn observation_text(name: String, kind: String, content: String) -> String
    "#{name} (#{kind}): #{content}"
  end

  @doc """
  Compose the text one event embeds under. The date joins the cue so
  a query about a period can find the events in it.
  """
  fn event_text(
    name: String,
    kind: String,
    occurred_at: DateTime,
    content: String,
  ) -> String

    "#{name} (#{kind}) on #{occurred_at.date().to_string()}: #{content}"
  end

  @doc """
  Embed an event an entity just gained and store the vector. Failure
  is logged, never surfaced, the same as `embed_observations`. The
  REST handler and the MCP tool share this function.
  """
  fn embed_event(
    conn: Postgres.Connection,
    embedder: Embedder,
    entity: Entity,
    event: Event,
  ) -> Postgres.Connection

    text = event_text(
      entity.name,
      entity.kind,
      event.occurred_at,
      event.content,
    )
    (conn, outcome) = store_events(conn, embedder, [event.id], [text])

    match outcome
      Result.Ok(_) ->
        ()

      Result.Err(e) ->
        Log.warn("Embedding an event on #{entity.name} failed. #{e.message()}")
    end

    conn
  end

  @doc """
  Embed observation rows an entity just gained and store the vectors.
  Failure is logged, never surfaced. The write already succeeded, and
  the backfill picks the rows up later. The REST handlers and the MCP
  tools share this function.
  """
  fn embed_observations(
    conn: Postgres.Connection,
    embedder: Embedder,
    entity: Entity,
    rows: List<(Int, String)>,
  ) -> Postgres.Connection

    if rows.empty?()
      return conn
    end

    ids: List<Int> = List.new()
    texts: List<String> = List.new()

    for row in rows
      (id, content) = row
      ids = ids.append(id)
      texts = texts.append(observation_text(entity.name, entity.kind, content))
    end

    (conn, outcome) = store_observations(conn, embedder, ids, texts)

    match outcome
      Result.Ok(_) ->
        ()

      Result.Err(e) ->
        Log.warn("Embedding #{entity.name} failed. #{e.message()}")
    end

    conn
  end

  @doc """
  Embed `texts` and store each vector on the observation with the
  matching id. Return the number of updated rows.
  """
  fn store_observations(
    conn: Postgres.Connection,
    embedder: Embedder,
    ids: List<Int>,
    texts: List<String>,
  ) -> (Postgres.Connection, Result<Int, Error>)

    vectors =
      match embedder.embed_many(texts)
        Result.Err(e) -> return (conn, Result.Err(e))
        Result.Ok(list) -> list
      end

    EntityStore.set_observation_embeddings(conn, ids, vectors)
  end

  @doc """
  Embed `texts` and store each vector on the event with the matching
  id. Return the number of updated rows.
  """
  fn store_events(
    conn: Postgres.Connection,
    embedder: Embedder,
    ids: List<Int>,
    texts: List<String>,
  ) -> (Postgres.Connection, Result<Int, Error>)

    vectors =
      match embedder.embed_many(texts)
        Result.Err(e) -> return (conn, Result.Err(e))
        Result.Ok(list) -> list
      end

    EventStore.set_embeddings(conn, ids, vectors)
  end
end
