alias HTTP.Headers
alias JSON.Value as Json
alias Log.Logger
alias OpenTelemetry.Attribute
alias OpenTelemetry.Propagation
alias OpenTelemetry.SpanContext
alias OpenTelemetry.SpanKind

# TEI rejects batches above its default `max-client-batch-size`.
priv const EMBED_BATCH: Int = 32

@doc """
Client for a TEI-protocol embedding server (nomic-embed-text,
768 dimensions). Vectors come back as pgvector text literals
(`[0.1,0.2,...]`), ready to bind as `$n::vector` parameters.

Each request runs in a `Client` span under `trace` and carries the
span as a `traceparent` header. The default `trace` records nothing.
Handlers bind the request's trace with `with_trace` before the call.
Best-effort embedding failures are logged through `log`.
"""
struct Embedder
  log: Logger
  trace: Trace = Trace{}
  url: String

  @doc """
  A copy of this client whose spans open under `trace`.
  """
  fn with_trace(self, trace: Trace) -> Embedder
    self.trace = trace
    self
  end

  @doc """
  Requests an embedding for one text. Fails with `Error.Embedding`
  when the server is unreachable, answers non-200, or returns a
  shape other than one array of numbers.
  """
  fn embed(self, text: String) -> String ! Error
    vectors = try self.embed_many([text])

    match vectors.first()
      Option.Some(vector) -> vector
      Option.None -> fail Error.Embedding("server returned no vector")
    end
  end

  @doc """
  Requests embeddings for many texts, in the same order. Requests go
  out in batches of `EMBED_BATCH` and the first failure aborts the
  rest.
  """
  fn embed_many(self, texts: List<String>) -> List<String> ! Error
    vectors: List<String> = List.new()

    if texts.empty?()
      return vectors
    end

    batches = (texts.length() + EMBED_BATCH - 1) / EMBED_BATCH

    for batch in Range{start: 0, stop: batches - 1}
      chunk = texts.slice(batch * EMBED_BATCH, EMBED_BATCH)
      vectors = vectors.concat(try self.request(chunk))
    end

    vectors
  end

  priv fn request(self, texts: List<String>) -> List<String> ! Error
    attributes: Map<String, Attribute> = [
      "http.request.method": "POST",
      "url.full": Attribute.from(self.url <> "/embed"),
      "embedding.batch_size": Attribute.from(texts.length())
    ]

    try self.trace.span_result(
      "POST /embed",
      SpanKind.Client,
      attributes,
      ctx -> self.post(ctx, texts),
    )
  end

  priv fn post(self, context: SpanContext, texts: List<String>)
    -> List<String> ! Error

    payload: Json = ["inputs": Json.Array(texts.map(t -> t.to_json()))]
    headers = Headers.new()
      .set("Content-Type", "application/json")
      .set(Propagation.HEADER, Propagation.header(context))

    response = HTTP.post(self.url <> "/embed", JSON.encode(payload), headers)
      rescue e -> fail Error.Embedding(e.message())

    if response.status.code != 200
      fail Error.Embedding("embedding server returned #{response.status.code}: " <>
        response.body)
    end

    decoded = JSON.decode(response.body)
      rescue e -> fail Error.Embedding("malformed response: " <> e)

    vectors = try vector_literals(decoded)

    if vectors.length() != texts.length()
      fail Error.Embedding("expected #{texts.length()} vectors, got #{vectors.length()}")
    end

    vectors
  end

  # TEI answers `[[f1, f2, ...], ...]`: one inner array per input.
  priv fn vector_literals(decoded: Json) -> List<String> ! Error
    outer =
      match decoded
        Json.Array(items) -> items
        _ -> fail Error.Embedding("expected a JSON array response")
      end

    literals: List<String> = List.new()

    for item in outer
      numbers =
        match item
          Json.Array(inner) -> inner
          _ -> fail Error.Embedding("expected a nested array of floats")
        end

      literals = literals.append(try vector_literal(numbers))
    end

    literals
  end

  priv fn vector_literal(numbers: List<Json>) -> String ! Error
    parts: List<String> = List.new()

    for number in numbers
      part =
        match number
          Json.Float(f) -> "#{f}"
          Json.Int(i) -> "#{i}"
          _ -> fail Error.Embedding("expected numeric vector components")
        end

      parts = parts.append(part)
    end

    "[" <> String.join(parts, ",") <> "]"
  end
end

@doc """
Composes the text one observation embeds under. The entity name and
type lead so the entity stays part of the cue.
"""
fn embedding_text(name: String, kind: String, content: String) -> String
  "#{name} (#{kind}): #{content}"
end

@doc """
Embeds observation rows an entity just gained and stores the vectors.
Failure is logged, never surfaced. The write already succeeded, and
the backfill picks the rows up later. Shared by the REST handlers
and the MCP tools.
"""
fn embed_rows(
  conn: Postgres.Connection,
  embedder: Embedder,
  entity: Entity,
  rows: List<(Int, String)>,
) -> Postgres.Connection

  if rows.empty?()
    return conn
  end

  ids: List<Int> = List.new()
  texts: List<String> = List.new()

  for row in rows
    (id, content) = row
    ids = ids.append(id)
    texts = texts.append(embedding_text(entity.name, entity.kind, content))
  end

  (conn, outcome) = embed_texts(conn, embedder, ids, texts)

  match outcome
    Result.Err(e) ->
      embedder.log.warn("embedding #{entity.name} failed: " <> e.message())
      conn

    Result.Ok(_) ->
      conn
  end
end

@doc """
Embeds `texts` and stores each vector on the observation with the
matching id. Returns how many rows were updated.
"""
fn embed_texts(
  conn: Postgres.Connection,
  embedder: Embedder,
  ids: List<Int>,
  texts: List<String>,
) -> (Postgres.Connection, Result<Int, Error>)

  vectors =
    match embedder.embed_many(texts)
      Result.Err(e) -> return (conn, Result.Err(e))
      Result.Ok(list) -> list
    end

  EntityStore.set_observation_embeddings(conn, ids, vectors)
end
