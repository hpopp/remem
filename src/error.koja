@doc """
Every error the remem package can produce. Store and embedding
failures wrap into these variants at the package boundary, and the
router maps each variant to an HTTP status.
"""
enum Error
  Database(String)
  Duplicate(String)
  Embedding(String)
  NotFound(String)
  Unavailable(String)
  Validation(String)

  @doc """
  Return a human-readable description of the error.
  """
  fn message(self) -> String
    match self
      Error.Database(detail) -> "database error: " <> detail
      Error.Duplicate(detail) -> detail
      Error.Embedding(detail) -> "embedding error: " <> detail
      Error.NotFound(detail) -> detail
      Error.Unavailable(detail) -> detail
      Error.Validation(detail) -> detail
    end
  end

  @doc """
  Wrap a driver error. A unique violation (SQLSTATE 23505) becomes
  `Duplicate` with the given description, everything else `Database`.
  """
  fn from_postgres(e: Postgres.Error, duplicate: String) -> Error
    match e
      Postgres.Error.Server(server_error) ->
        server_error.code == "23505"
          ? Error.Duplicate(duplicate)
          : Error.Database(e.message())

      _ ->
        Error.Database(e.message())
    end
  end

  @doc """
  If `outcome` is an `Err`, set the span status to `Error` with the
  error's message. Return `outcome` unchanged in both cases.
  """
  fn mark_span<T>(span: Trace.Span, outcome: Result<T, Error>)
    -> Result<T, Error>

    match outcome
      Result.Err(e) -> span.status(Trace.Status.Error(e.message()))
      Result.Ok(_) -> ()
    end

    outcome
  end
end
