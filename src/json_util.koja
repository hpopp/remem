alias JSON.Value as JSONValue

@doc """
Helpers for reading `JSON.Value` trees: request-body parsing for the
router and decoding of JSON-shaped columns from the stores.
"""
struct JsonUtil
  @doc """
  Parse a `POST /entities` body. `name` and `type` are required
  non-empty strings, `observations` an optional array of strings.
  """
  fn parse_entity(body: String) -> (String, String, List<String>) ! Error
    root = try decode(body)
    name = try required_string(root, "name")
    kind = try required_string(root, "type")

    observations =
      match field(root, "observations")
        Option.None -> List.new()
        Option.Some(value) ->
          try string_list(value).or_err(
            Error.Validation("observations must be an array of strings"),
          )
      end

    (name, kind, observations)
  end

  @doc """
  Parse an observations body. `observations` is a required,
  non-empty array of strings.
  """
  fn parse_observations(body: String) -> List<String> ! Error
    root = try decode(body)

    observations =
      match field(root, "observations")
        Option.None -> fail Error.Validation("observations is required")
        Option.Some(value) ->
          try string_list(value).or_err(
            Error.Validation("observations must be an array of strings"),
          )
      end

    if observations.empty?()
      fail Error.Validation("observations must not be empty")
    end

    observations
  end

  @doc """
  Parse an event body. `content` is a required non-empty string and
  `occurred_at` an optional RFC 3339 timestamp.
  """
  fn parse_event(body: String) -> (String, Option<DateTime>) ! Error
    root = try decode(body)
    content = try required_string(root, "content")
    occurred_at = try JsonUtil.occurred_at(root)
    (content, occurred_at)
  end

  @doc """
  Read an optional `occurred_at` field as a `DateTime`. An absent
  field reads as `None`. A field that is not RFC 3339 fails with
  `Validation`. The REST body parser and the MCP tool share this
  function.
  """
  fn occurred_at(root: JSONValue) -> Option<DateTime> ! Error
    match field(root, "occurred_at")
      Option.None ->
        Option.None

      Option.Some(JSONValue.String(text)) ->
        parsed = DateTime.parse(text)
          rescue _ -> fail Error.Validation("occurred_at must be RFC 3339, got '#{text}'")
        Option.Some(parsed.to_utc())

      Option.Some(_) ->
        fail Error.Validation("occurred_at must be an RFC 3339 string")
    end
  end

  @doc """
  Parse a relation body. `from`, `to`, and `type` are required
  non-empty strings.
  """
  fn parse_relation(body: String) -> (String, String, String) ! Error
    root = try decode(body)
    from = try required_string(root, "from")
    to = try required_string(root, "to")
    kind = try required_string(root, "type")
    (from, to, kind)
  end

  @doc """
  Encode a list of strings as JSON array text, for binding as a
  `$n::jsonb` parameter.
  """
  fn encode_string_list(items: List<String>) -> String
    JSON.encode(JSONValue.Array(items.map(item -> item.to_json())))
  end

  @doc """
  Decode the `json_agg` observation column from a store query into
  observation values. The column is built by the store's own SQL, so
  malformed text, a non-array root, or an unreadable timestamp is a
  bug and fails with `Error.Database`.
  """
  fn decode_observations(text: String) -> List<Observation> ! Error
    decoded = JSON.decode(text)
      rescue e -> fail Error.Database("malformed observations column: " <> e)

    items =
      match decoded
        JSONValue.Array(list) -> list
        _ -> fail Error.Database("observations column is not an array")
      end

    observations: List<Observation> = List.new()

    for item in items
      observations = observations.append(
        Observation{
          content: field_string(item, "content"),
          created_at: try Database.Row.time(field_string(item, "created_at")),
          updated_at: try Database.Row.time(field_string(item, "updated_at")),
        },
      )
    end

    observations
  end

  @doc """
  Decode the matching-observations column from a search query into
  hits. Malformed text gives an empty list.
  """
  fn decode_hits(text: String) -> List<ObservationHit>
    hits: List<ObservationHit> = List.new()

    decoded =
      match JSON.decode(text)
        Result.Err(_) -> return hits
        Result.Ok(value) -> value
      end

    match decoded
      JSONValue.Array(items) ->
        for item in items
          hits = hits.append(
            ObservationHit{
              content: field_string(item, "content"),
              score: field_float(item, "score"),
            },
          )
        end

        hits

      _ ->
        hits
    end
  end

  @doc """
  Read a request body's optional `confirm` flag. An absent or
  non-bool flag reads as `false`.
  """
  fn parse_confirm(body: String) -> Bool
    match JSON.decode(body)
      Result.Err(_) -> false
      Result.Ok(root) -> get_bool(root, "confirm").or(false)
    end
  end

  @doc """
  Parse a body with one required non-empty string field.
  """
  fn parse_string_field(body: String, key: String) -> String ! Error
    root = try decode(body)
    try required_string(root, key)
  end

  @doc """
  Remove duplicate strings. Keep the first occurrences in order.
  """
  fn distinct(items: List<String>) -> List<String>
    seen: List<String> = List.new()

    for item in items
      if not seen.any?(s -> s == item)
        seen = seen.append(item)
      end
    end

    seen
  end

  @doc """
  Return an object field's value, or `None` for a missing key or a
  non-object root.
  """
  fn get(root: JSONValue, key: String) -> Option<JSONValue>
    field(root, key)
  end

  @doc """
  Return an object field's string value, or `None` when the field is
  missing or not a string.
  """
  fn get_string(root: JSONValue, key: String) -> Option<String>
    match field(root, key)
      Option.Some(JSONValue.String(text)) -> Option.Some(text)
      _ -> Option.None
    end
  end

  @doc """
  Return an object field's integer value, or `None` when the field
  is missing or not an integer.
  """
  fn get_int(root: JSONValue, key: String) -> Option<Int>
    match field(root, key)
      Option.Some(JSONValue.Int(number)) -> Option.Some(number)
      _ -> Option.None
    end
  end

  @doc """
  Return an object field's boolean value, or `None` when the field
  is missing or not a boolean.
  """
  fn get_bool(root: JSONValue, key: String) -> Option<Bool>
    match field(root, key)
      Option.Some(JSONValue.Bool(flag)) -> Option.Some(flag)
      _ -> Option.None
    end
  end

  @doc """
  Return an object field's value as a list of strings, or `None`
  when the field is missing or not an all-string array.
  """
  fn get_string_list(root: JSONValue, key: String) -> Option<List<String>>
    match field(root, key)
      Option.Some(value) -> string_list(value)
      Option.None -> Option.None
    end
  end

  priv fn decode(body: String) -> JSONValue ! Error
    JSON.decode(body)
      rescue e -> fail Error.Validation("malformed JSON body: " <> e)
  end

  priv fn field(root: JSONValue, key: String) -> Option<JSONValue>
    match root
      JSONValue.Object(entries) ->
        for entry in entries
          (entry_key, entry_value) = entry

          if entry_key == key
            return Option.Some(entry_value)
          end
        end

        Option.None

      _ ->
        Option.None
    end
  end

  priv fn field_string(root: JSONValue, key: String) -> String
    match field(root, key)
      Option.Some(JSONValue.String(text)) -> text
      _ -> ""
    end
  end

  priv fn field_float(root: JSONValue, key: String) -> Float
    match field(root, key)
      Option.Some(JSONValue.Float(f)) -> f
      Option.Some(JSONValue.Int(i)) -> "#{i}".to_float() rescue _ -> 0.0
      _ -> 0.0
    end
  end

  priv fn required_string(root: JSONValue, key: String) -> String ! Error
    match field(root, key)
      Option.Some(JSONValue.String(text)) when not text.empty?() -> text
      Option.Some(_) ->
        fail Error.Validation("#{key} must be a non-empty string")
      Option.None -> fail Error.Validation("#{key} is required")
    end
  end

  priv fn string_list(value: JSONValue) -> Option<List<String>>
    match value
      JSONValue.Array(items) ->
        strings: List<String> = List.new()

        for item in items
          match item
            JSONValue.String(text) -> strings = strings.append(text)
            _ -> return Option.None
          end
        end

        Option.Some(strings)

      _ ->
        Option.None
    end
  end
end
