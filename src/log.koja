@doc """
Leveled stdout logging with UTC ISO-8601 timestamps, like:

    2026-09-01T23:08:12.123456Z INFO POST /entities 201 12ms
"""
struct Log
  fn info(message: String)
    IO.puts("#{now()} INFO #{message}")
  end

  fn warn(message: String)
    IO.puts("#{now()} WARN #{message}")
  end

  fn error(message: String)
    IO.puts("#{now()} ERROR #{message}")
  end

  @doc """
  Formats an elapsed time the way `koja test` does. The unit follows
  the size, so `452µs` below one millisecond, `3ms` below one second,
  and `1.2s` from there.
  """
  fn elapsed(duration: Duration) -> String
    microseconds = duration.to_microseconds()

    cond
      microseconds < 1_000 ->
        "#{microseconds}µs"

      microseconds < 1_000_000 ->
        "#{duration.to_milliseconds()}ms"

      else ->
        tenths = duration.to_milliseconds() / 100
        "#{tenths / 10}.#{tenths % 10}s"
    end
  end

  priv fn now() -> String
    DateTime.now(TimeZone.UTC).to_string()
  end
end
