alias HTTP.Response
alias JSON.Value as JSONValue
alias Postgres.Connection

@doc """
The tools that read and write entities. `search_memory`,
`get_entity`, `create_entity`, `rename_entity`, `merge_entities`,
`list_entities`, and `delete_entity`. Each fn validates its
arguments, runs the store, and answers with a `ToolResult`.
"""
struct EntityTools
  @doc """
  Search for entities that match a query.
  """
  fn search(
    arguments: JSONValue,
    id: JSONValue,
    conn: Connection,
    embedder: Embedder,
  ) -> (Response, Connection)

    query =
      match JsonUtil.get_string(arguments, "query")
        Option.Some(text) when not text.empty?() -> text
        _ -> return (ToolResult.err(id, "query is required"), conn)
      end

    limit = JsonUtil.get_int(arguments, "limit").or(MCP.DEFAULT_SEARCH_LIMIT)

    if limit < 1 or limit > MCP.MAX_SEARCH_LIMIT
      return (
        ToolResult.err(
          id,
          "limit must be between 1 and #{MCP.MAX_SEARCH_LIMIT}",
        ), conn
      )
    end

    # The log is bookkeeping, so a failed insert never fails the search.
    (conn, logged) = SearchLog.record(conn, query)
    logged rescue e -> Log.warn("Search log write failed. #{e.message()}")

    # Embedder down means fuzzy-only ranking, not a failed search.
    embedding =
      match embedder.embed(query)
        Result.Ok(vector) ->
          Option.Some(vector)

        Result.Err(e) ->
          Log.warn(
            "Embedding failed, search falls back to fuzzy ranking. #{e.message()}",
          )
          Option.None
      end

    (conn, found) = EntityStore.search(conn, query, embedding, limit)
    (ToolResult.render(id, search_payload(query, found)), conn)
  end

  @doc """
  Fetch one entity with its relations and recent events.
  """
  fn get(arguments: JSONValue, id: JSONValue, conn: Connection)
    -> (Response, Connection)

    name =
      match JsonUtil.get_string(arguments, "name")
        Option.Some(text) when not text.empty?() -> text
        _ -> return (ToolResult.err(id, "name is required"), conn)
      end

    (conn, found) = EntityStore.find(conn, name)

    entity =
      match EntityStore.required(found, name)
        Result.Err(e) -> return (ToolResult.err(id, e.message()), conn)
        Result.Ok(present) -> present
      end

    (conn, relations) = RelationStore.for_entity(conn, name)

    relation_list =
      match relations
        Result.Err(e) -> return (ToolResult.err(id, e.message()), conn)
        Result.Ok(list) -> list
      end

    (conn, events) = EventStore.recent(conn, name, EventStore.RECENT_EVENTS)
    (ToolResult.render(id, entity_payload(entity, relation_list, events)), conn)
  end

  @doc """
  Create an entity.
  """
  fn create(
    arguments: JSONValue,
    id: JSONValue,
    conn: Connection,
    embedder: Embedder,
  ) -> (Response, Connection)

    name =
      match JsonUtil.get_string(arguments, "name")
        Option.Some(text) when not text.empty?() -> text
        _ -> return (ToolResult.err(id, "name is required"), conn)
      end

    kind =
      match JsonUtil.get_string(arguments, "type")
        Option.Some(text) when not text.empty?() -> text
        _ -> return (ToolResult.err(id, "type is required"), conn)
      end

    observations = JsonUtil.distinct(
      JsonUtil.get_string_list(arguments, "observations").or(List.new()),
    )

    confirm = JsonUtil.get_bool(arguments, "confirm").or(false)

    (conn, created) = EntityStore.create(
      conn,
      name,
      kind,
      observations,
      confirm,
    )

    match created
      Result.Err(e) ->
        (ToolResult.err(id, e.message()), conn)

      Result.Ok(pair) ->
        (entity, rows) = pair
        conn = Embedding.embed_observations(conn, embedder, entity, rows)
        (ToolResult.ok(id, entity.to_json()), conn)
    end
  end

  @doc """
  Rename an entity.
  """
  fn rename(arguments: JSONValue, id: JSONValue, conn: Connection)
    -> (Response, Connection)

    name =
      match JsonUtil.get_string(arguments, "name")
        Option.Some(text) when not text.empty?() -> text
        _ -> return (ToolResult.err(id, "name is required"), conn)
      end

    new_name =
      match JsonUtil.get_string(arguments, "new_name")
        Option.Some(text) when not text.empty?() -> text
        _ -> return (ToolResult.err(id, "new_name is required"), conn)
      end

    (conn, renamed) = EntityStore.rename(conn, name, new_name)
    (ToolResult.render(id, EntityStore.required(renamed, name)), conn)
  end

  @doc """
  Merge two entities.
  """
  fn merge(arguments: JSONValue, id: JSONValue, conn: Connection)
    -> (Response, Connection)

    source =
      match JsonUtil.get_string(arguments, "source")
        Option.Some(text) when not text.empty?() -> text
        _ -> return (ToolResult.err(id, "source is required"), conn)
      end

    into =
      match JsonUtil.get_string(arguments, "into")
        Option.Some(text) when not text.empty?() -> text
        _ -> return (ToolResult.err(id, "into is required"), conn)
      end

    (conn, merged) = EntityStore.merge(conn, source, into)
    (ToolResult.render(id, merged), conn)
  end

  @doc """
  Fetch a list of entity summaries.
  """
  fn list(arguments: JSONValue, id: JSONValue, conn: Connection)
    -> (Response, Connection)

    limit = JsonUtil.get_int(arguments, "limit").or(Params.DEFAULT_PAGE_LIMIT)
    offset = JsonUtil.get_int(arguments, "offset").or(0)

    if limit < 1 or limit > Params.MAX_PAGE_LIMIT
      return (
        ToolResult.err(
          id,
          "limit must be between 1 and #{Params.MAX_PAGE_LIMIT}",
        ), conn
      )
    end

    if offset < 0
      return (ToolResult.err(id, "offset must not be negative"), conn)
    end

    (conn, listed) = EntityStore.summaries(conn, limit, offset)
    (ToolResult.render(id, list_payload(listed)), conn)
  end

  @doc """
  Delete an entity.
  """
  fn delete(arguments: JSONValue, id: JSONValue, conn: Connection)
    -> (Response, Connection)

    name =
      match JsonUtil.get_string(arguments, "name")
        Option.Some(text) when not text.empty?() -> text
        _ -> return (ToolResult.err(id, "name is required"), conn)
      end

    (conn, removed) = EntityStore.remove(conn, name)

    (
      ToolResult.deleted(
        id,
        removed,
        "deleted #{name}",
        "no entity named #{name}",
      ), conn
    )
  end

  priv fn search_payload(
    query: String,
    found: Result<List<SearchResult>, Error>,
  ) -> JSONValue ! Error

    results = try found
    payload: JSONValue = [
      "query": query.to_json(),
      "results": JSONValue.Array(results.map(r -> r.to_json()))
    ]
    payload
  end

  priv fn entity_payload(
    entity: Entity,
    relations: List<Relation>,
    events: Result<Option<List<Event>>, Error>,
  ) -> JSONValue ! Error

    # The entity was found a moment ago, so `None` means it vanished
    # mid-read. An empty list is the honest answer.
    recent = try events
    payload: JSONValue = [
      "entity": entity.to_json(),
      "relations": JSONValue.Array(relations.map(r -> r.to_json())),
      "events": JSONValue.Array(recent.or(List.new()).map(e -> e.to_json()))
    ]
    payload
  end

  priv fn list_payload(listed: Result<List<EntitySummary>, Error>)
    -> JSONValue ! Error

    summaries = try listed
    payload: JSONValue = [
      "entities": JSONValue.Array(summaries.map(s -> s.to_json()))
    ]
    payload
  end
end
