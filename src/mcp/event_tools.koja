alias HTTP.Response
alias JSON.Value as JSONValue
alias Postgres.Connection

@doc """
The `add_event`, `recent_events`, and `remove_event` tools. Events
are addressed by integer id, so `remove_event` takes an id where the
observation tools take content.
"""
struct EventTools
  @doc """
  Add an event to an entity.
  """
  fn add(
    arguments: JSONValue,
    id: JSONValue,
    conn: Connection,
    embedder: Embedder,
  ) -> (Response, Connection)

    name =
      match JsonUtil.get_string(arguments, "name")
        Option.Some(text) when not text.empty?() -> text
        _ -> return (ToolResult.err(id, "name is required"), conn)
      end

    content =
      match JsonUtil.get_string(arguments, "content")
        Option.Some(text) when not text.empty?() -> text
        _ -> return (ToolResult.err(id, "content is required"), conn)
      end

    occurred_at =
      match JsonUtil.occurred_at(arguments)
        Result.Err(e) -> return (ToolResult.err(id, e.message()), conn)
        Result.Ok(maybe) -> maybe
      end

    (conn, added) = EventStore.add(conn, name, content, occurred_at)

    match EntityStore.required(added, name)
      Result.Err(e) ->
        (ToolResult.err(id, e.message()), conn)

      Result.Ok(pair) ->
        (event, entity) = pair
        conn = Embedding.embed_event(conn, embedder, entity, event)
        (ToolResult.ok(id, event.to_json()), conn)
    end
  end

  @doc """
  Fetch the recent events of an entity.
  """
  fn recent(arguments: JSONValue, id: JSONValue, conn: Connection)
    -> (Response, Connection)

    name =
      match JsonUtil.get_string(arguments, "name")
        Option.Some(text) when not text.empty?() -> text
        _ -> return (ToolResult.err(id, "name is required"), conn)
      end

    limit = JsonUtil.get_int(arguments, "limit").or(EventStore.RECENT_EVENTS)

    if limit < 1 or limit > MCP.MAX_SEARCH_LIMIT
      return (
        ToolResult.err(
          id,
          "limit must be between 1 and #{MCP.MAX_SEARCH_LIMIT}",
        ), conn
      )
    end

    (conn, found) = EventStore.recent(conn, name, limit)
    (ToolResult.render(id, recent_payload(name, found)), conn)
  end

  @doc """
  Remove an event by id.
  """
  fn remove(arguments: JSONValue, id: JSONValue, conn: Connection)
    -> (Response, Connection)

    event_id =
      match JsonUtil.get_int(arguments, "id")
        Option.Some(number) -> number
        Option.None -> return (ToolResult.err(id, "id is required"), conn)
      end

    (conn, removed) = EventStore.remove(conn, event_id)

    (
      ToolResult.deleted(
        id,
        removed,
        "deleted event #{event_id}",
        "no event with id #{event_id}",
      ), conn
    )
  end

  priv fn recent_payload(
    name: String,
    found: Result<Option<List<Event>>, Error>,
  ) -> JSONValue ! Error

    events = try EntityStore.required(found, name)
    payload: JSONValue = [
      "name": name.to_json(),
      "events": JSONValue.Array(events.map(e -> e.to_json()))
    ]
    payload
  end
end
