alias HTTP.Response
alias JSON.Value as JSONValue
alias Postgres.Connection
alias Trace.Attribute

@doc """
MCP server endpoint (streamable HTTP transport) at `POST /mcp`. The
server is stateless and never streams, so each JSON-RPC message gets
one JSON response and `GET /mcp` is a 405.

`MCP` is the framing and the dispatch table. The tool catalog is
`ToolCatalog`, response builders are `RPC` and `ToolResult`, and the
tools themselves live in `EntityTools`, `ObservationTools`,
`EventTools`, and `RelationTools`.

Tools mirror the REST API, with one deliberate omission. There is no
read-the-whole-graph tool. Search is the way in, so agent clients
retrieve by relevance instead of loading everything. `list_entities`
returns names and counts only, for curation. Tool descriptions steer
agents to search before writing and to keep the graph curated.
"""
struct MCP
  @doc """
  The MCP protocol revision that the `initialize` response reports.
  """
  const PROTOCOL_VERSION: String = "2025-06-18"

  @doc """
  The number of results the `search_memory` tool returns when the
  call sets no `limit`.
  """
  const DEFAULT_SEARCH_LIMIT: Int = 10

  @doc """
  The largest `limit` that the `search_memory` and `recent_events`
  tools accept.
  """
  const MAX_SEARCH_LIMIT: Int = 100

  @doc """
  Handle one decoded JSON-RPC message. Notifications get 202 with no
  body.
  A `tools/call` runs in its own span under the calling process's
  context and logs through the calling process's `Log` configuration.
  """
  fn handle(root: JSONValue, conn: Connection, embedder: Embedder)
    -> (Response, Connection)

    method =
      match JSON.get(root, "method")
        Option.Some(text: String) -> text
        _ -> ""
      end

    id =
      match JSON.get(root, "id")
        Option.Some(value) -> value
        Option.None -> return (RPC.accepted(), conn)
      end

    match method
      "initialize" -> (RPC.result(id, initialize_result()), conn)
      "ping" -> (RPC.result(id, [:]), conn)
      "tools/list" -> (RPC.result(id, tools_result()), conn)
      "tools/call" -> call_tool(root, id, conn, embedder)
      _ -> (RPC.error(id, -32601, "no such method #{method}"), conn)
    end
  end

  @doc """
  Build the JSON-RPC parse error that answers a body that is not
  JSON. The caller decodes the body, so `handle` never sees one.
  """
  fn malformed -> Response
    RPC.error(JSON.NULL, -32700, "malformed JSON-RPC message")
  end

  # Names the tool in the log and the trace, then dispatches it. The
  # embedder's request nests under the tool span through the process
  # context.
  priv fn call_tool(
    root: JSONValue,
    id: JSONValue,
    conn: Connection,
    embedder: Embedder,
  ) -> (Response, Connection)

    params = JSON.get(root, "params").or(JSON.NULL)

    name =
      match JSON.get(params, "name")
        Option.Some(text: String) -> text
        _ -> ""
      end

    arguments = JSON.get(params, "arguments").or(JSON.NULL)

    # The access log only shows POST /mcp, so name the tool here.
    Log.info("MCP tools/call #{name}.")

    Trace.span("tools/call", fn (span: Trace.Span) -> (Response, Connection)
        span.attribute("mcp.tool", Attribute.from(name))
        dispatch_tool(name, arguments, id, conn, embedder)
      end)
  end

  priv fn dispatch_tool(
    name: String,
    arguments: JSONValue,
    id: JSONValue,
    conn: Connection,
    embedder: Embedder,
  ) -> (Response, Connection)

    match name
      "search_memory" ->
        EntityTools.search(arguments, id, conn, embedder)

      "get_entity" ->
        EntityTools.get(arguments, id, conn)

      "create_entity" ->
        EntityTools.create(arguments, id, conn, embedder)

      "rename_entity" ->
        EntityTools.rename(arguments, id, conn)

      "merge_entities" ->
        EntityTools.merge(arguments, id, conn)

      "list_entities" ->
        EntityTools.list(arguments, id, conn)

      "delete_entity" ->
        EntityTools.delete(arguments, id, conn)

      "add_observations" ->
        ObservationTools.add(arguments, id, conn, embedder)

      "remove_observations" ->
        ObservationTools.remove(arguments, id, conn)

      "add_event" ->
        EventTools.add(arguments, id, conn, embedder)

      "recent_events" ->
        EventTools.recent(arguments, id, conn)

      "remove_event" ->
        EventTools.remove(arguments, id, conn)

      "create_relation" ->
        RelationTools.create(arguments, id, conn)

      "delete_relation" ->
        RelationTools.delete(arguments, id, conn)

      _ ->
        (RPC.error(id, -32602, "no such tool #{name}"), conn)
    end
  end

  priv fn initialize_result -> JSONValue
    [
      "protocolVersion": MCP.PROTOCOL_VERSION,
      "capabilities": ["tools": [:]],
      "serverInfo": ["name": "remem", "version": PACKAGE_VERSION]
    ]
  end

  priv fn tools_result -> JSONValue
    ["tools": ToolCatalog.tools()]
  end
end
