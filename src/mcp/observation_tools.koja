alias HTTP.Response
alias JSON.Value as Json
alias Log.Logger
alias Postgres.Connection

@doc """
The `add_observations` and `remove_observations` tools. Both take
the same `{name, observations}` arguments.
"""
struct ObservationTools
  fn add(
    arguments: Json,
    id: Json,
    conn: Connection,
    embedder: Embedder,
    log: Logger,
  ) -> (Response, Connection)

    (name, observations) =
      match args(arguments)
        Result.Ok(parsed) -> parsed
        Result.Err(message) -> return (ToolResult.err(log, id, message), conn)
      end

    (conn, updated) = EntityStore.add_observations(conn, name, observations)

    match required(updated, name)
      Result.Err(e) ->
        (ToolResult.err(log, id, e.message()), conn)

      Result.Ok(pair) ->
        (entity, rows) = pair
        conn = embed_rows(conn, embedder, entity, rows)
        (ToolResult.ok(id, entity.to_json()), conn)
    end
  end

  fn remove(arguments: Json, id: Json, conn: Connection, log: Logger)
    -> (Response, Connection)

    (name, observations) =
      match args(arguments)
        Result.Ok(parsed) -> parsed
        Result.Err(message) -> return (ToolResult.err(log, id, message), conn)
      end

    (conn, updated) = EntityStore.remove_observations(conn, name, observations)
    (ToolResult.render(log, id, required(updated, name)), conn)
  end

  priv fn args(arguments: Json) -> (String, List<String>) ! String
    name =
      match JsonUtil.get_string(arguments, "name")
        Option.Some(text) when not text.empty?() -> text
        _ -> fail "name is required"
      end

    observations =
      match JsonUtil.get_string_list(arguments, "observations")
        Option.Some(list) when not list.empty?() -> JsonUtil.distinct(list)
        _ -> fail "observations must be a non-empty string array"
      end

    (name, observations)
  end
end
