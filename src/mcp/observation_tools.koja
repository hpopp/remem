alias HTTP.Response
alias JSON.Value as JSONValue
alias Postgres.Connection

@doc """
The `add_observations` and `remove_observations` tools. Both take
the same `{name, observations}` arguments.
"""
struct ObservationTools
  @doc """
  Add observations to an entity.
  """
  fn add(
    arguments: JSONValue,
    id: JSONValue,
    conn: Connection,
    embedder: Embedder,
  ) -> (Response, Connection)

    (name, observations) =
      match args(arguments)
        Result.Ok(parsed) -> parsed
        Result.Err(message) -> return (ToolResult.err(id, message), conn)
      end

    (conn, updated) = EntityStore.add_observations(conn, name, observations)

    match EntityStore.required(updated, name)
      Result.Err(e) ->
        (ToolResult.err(id, e.message()), conn)

      Result.Ok(pair) ->
        (entity, rows) = pair
        conn = Embedding.embed_observations(conn, embedder, entity, rows)
        (ToolResult.ok(id, entity.to_json()), conn)
    end
  end

  @doc """
  Remove observations from an entity.
  """
  fn remove(arguments: JSONValue, id: JSONValue, conn: Connection)
    -> (Response, Connection)

    (name, observations) =
      match args(arguments)
        Result.Ok(parsed) -> parsed
        Result.Err(message) -> return (ToolResult.err(id, message), conn)
      end

    (conn, updated) = EntityStore.remove_observations(conn, name, observations)
    (ToolResult.render(id, EntityStore.required(updated, name)), conn)
  end

  priv fn args(arguments: JSONValue) -> (String, List<String>) ! String
    name =
      match JsonUtil.get_string(arguments, "name")
        Option.Some(text) when not text.empty?() -> text
        _ -> fail "name is required"
      end

    observations =
      match JsonUtil.get_string_list(arguments, "observations")
        Option.Some(list) when not list.empty?() -> JsonUtil.distinct(list)
        _ -> fail "observations must be a non-empty string array"
      end

    (name, observations)
  end
end
