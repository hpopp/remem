alias HTTP.Headers
alias HTTP.Response
alias HTTP.Status
alias JSON.Value as JSONValue

@doc """
JSON-RPC 2.0 response builders for the MCP endpoint. Every reply is
one HTTP 200 with a JSON body, except a notification, which is a
bare 202.
"""
struct RPC
  @doc """
  Build a JSON-RPC success response for `id`.
  """
  fn result(id: JSONValue, result: JSONValue) -> Response
    body: JSONValue = ["jsonrpc": "2.0".to_json(), "id": id, "result": result]
    http_json(body)
  end

  @doc """
  Build a JSON-RPC error response with `code` and `message`.
  """
  fn error(id: JSONValue, code: Int, message: String) -> Response
    detail: JSONValue = ["code": code.to_json(), "message": message.to_json()]
    body: JSONValue = ["jsonrpc": "2.0".to_json(), "id": id, "error": detail]
    http_json(body)
  end

  @doc """
  Build the empty 202 response that answers a notification.
  """
  fn accepted -> Response
    headers = Headers.new().set("Content-Length", "0")
    Response{
      body: "",
      headers: headers,
      status: Status.new(202, "Accepted"),
      version: "HTTP/1.1",
    }
  end

  @doc """
  Build an empty JSON object.
  """
  fn empty_object -> JSONValue
    entries: List<(String, JSONValue)> = List.new()
    JSONValue.Object(entries)
  end

  priv fn http_json(body: JSONValue) -> Response
    text = JSON.encode(body)
    headers =
      Headers.new()
      .set("Content-Type", "application/json")
      .set("Content-Length", "#{text.byte_length()}")
    Response{
      body: text,
      headers: headers,
      status: Status.ok(),
      version: "HTTP/1.1",
    }
  end
end

@doc """
Builders for a `tools/call` result. A tool answers with one text
content item and an `isError` flag, so a failed tool call is still a
successful JSON-RPC response.
"""
struct ToolResult
  @doc """
  Build a successful tool result with `payload` as JSON text content.
  """
  fn ok(id: JSONValue, payload: JSONValue) -> Response
    RPC.result(id, tool_result(JSON.encode(payload), false))
  end

  @doc """
  Build a successful tool result with `text` as its content.
  """
  fn text(id: JSONValue, text: String) -> Response
    RPC.result(id, tool_result(text, false))
  end

  @doc """
  Log a warning and build a failed tool result with `message`.
  """
  fn err(id: JSONValue, message: String) -> Response
    Log.warn("MCP tool returned an error. #{message}")
    RPC.result(id, tool_result(message, true))
  end

  @doc """
  Render a store outcome. Success renders the value as JSON, and
  failure renders the error's message.
  """
  fn render<T: JSON.Encoding>(id: JSONValue, outcome: Result<T, Error>)
    -> Response

    match outcome
      Result.Ok(value) -> ok(id, value.to_json())
      Result.Err(e) -> err(id, e.message())
    end
  end

  @doc """
  Render a delete. If a row went, the result is `text`. If nothing
  matched, the result is `missing` as an error.
  """
  fn deleted(
    id: JSONValue,
    removed: Result<Bool, Error>,
    text: String,
    missing: String,
  ) -> Response

    match removed
      Result.Err(e) -> err(id, e.message())
      Result.Ok(true) -> ToolResult.text(id, text)
      Result.Ok(false) -> err(id, missing)
    end
  end

  priv fn tool_result(text: String, is_error: Bool) -> JSONValue
    item: JSONValue = ["type": "text".to_json(), "text": text.to_json()]
    result: JSONValue = [
      "content": JSONValue.Array([item]), "isError": is_error.to_json()
    ]
    result
  end
end
