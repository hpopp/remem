alias Trail.Conn

@doc """
Request parameter readers, failing with `Validation` (rendered as
400) on bad input.
"""
struct Params
  @doc """
  The page size when a request sets no `limit`.
  """
  const DEFAULT_PAGE_LIMIT: Int = 100

  @doc """
  The largest page size a request can ask for.
  """
  const MAX_PAGE_LIMIT: Int = 1000

  @doc """
  Read the `:name` path parameter. The router has already decoded it.
  """
  fn name(c: Conn) -> String
    c.param("name").or("")
  end

  @doc """
  Read the `:id` path parameter as an integer.
  """
  fn id(c: Conn) -> Int ! Error
    text = c.param("id").or("")

    text.to_int()
      rescue _ -> fail Error.Validation("id must be an integer, got '#{text}'")
  end

  @doc """
  Read and bound the `limit` and `offset` pagination parameters.
  """
  fn page(c: Conn) -> (Int, Int) ! Error
    limit = try Params.limit(c, Params.DEFAULT_PAGE_LIMIT)
    offset = try Params.int(c, "offset", 0)

    if offset < 0
      fail Error.Validation("offset must not be negative")
    end

    (limit, offset)
  end

  @doc """
  Read the `limit` query parameter, `default` when absent, and
  bound it to the page rules.
  """
  fn limit(c: Conn, default: Int) -> Int ! Error
    limit = try Params.int(c, "limit", default)

    if limit < 1 or limit > Params.MAX_PAGE_LIMIT
      fail Error.Validation("limit must be between 1 and #{Params.MAX_PAGE_LIMIT}")
    end

    limit
  end

  @doc """
  Read the `name` query parameter as an integer. If the parameter is
  absent, return `default`.
  """
  fn int(c: Conn, name: String, default: Int) -> Int ! Error
    match c.query_param(name)
      Option.None -> default
      Option.Some(text) ->
        text.to_int()
          rescue _ -> fail Error.Validation("#{name} must be an integer, got '#{text}'")
    end
  end
end
