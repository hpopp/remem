alias Conn.Conn
alias Conn.Router
alias HTTP.Headers
alias HTTP.Method
alias HTTP.Response
alias HTTP.Status
alias JSON.Value as Json
alias Log.Logger
alias OpenTelemetry.Attribute
alias OpenTelemetry.SpanKind
alias OpenTelemetry.Tracer
alias Pooler.Pool
alias Postgres.Connection

const DEFAULT_PAGE_LIMIT: Int = 100
const MAX_PAGE_LIMIT: Int = 1000

priv const CHECKOUT_MS: Int = 5000

@doc """
Builds the route table. Controllers capture their dependencies when
the router is built, so the routes themselves are plain
`fn (Conn) -> Conn` closures.

Two middleware steps run before any route matches. The bearer-auth
check covers every route except `GET /health` when `API_KEY` is
set, and the method guard answers 405 for verbs no route uses. Both
halt before any database connection leaves the pool, and so does
the 404 fallback.
"""
fn build_router(
  pool: Pool<Connection>,
  embedder: Embedder,
  api_key: Option<String>,
  tracer: Tracer,
  log: Logger = Logger.default(),
) -> Router

  trace = Trace{tracer: Option.Some(tracer)}
  entities = EntityController{embedder: embedder, pool: pool, trace: trace}
  events = EventController{embedder: embedder, pool: pool, trace: trace}
  relations = RelationController{pool: pool, trace: trace}
  search = SearchController{
    embedder: embedder,
    log: log,
    pool: pool,
    trace: trace,
  }
  meta = MetaController{embedder: embedder, log: log, pool: pool, trace: trace}

  auth =
    fn (c: Conn) -> Conn
      exempt = c.method == Method.Get and c.path == "/health"

      if exempt or authorized?(c, api_key)
        c
      else
        Render.failure(
          c,
          Status.new(401, "Unauthorized"),
          "missing or invalid API key",
        ).halt()
      end
    end

  method_guard =
    fn (c: Conn) -> Conn
      allowed = c.method == Method.Get or c.method == Method.Post
        or c.method == Method.Patch or c.method == Method.Delete

      if allowed
        c
      else
        Render.failure(
          c,
          Status.method_not_allowed(),
          "#{c.method.to_string()} is not supported",
        ).halt()
      end
    end

  Router.new()
    .use(auth)
    .use(method_guard)
    .not_found(c -> Render.failure(c, Status.not_found(), "no such route"))
    .get("/health", c -> meta.health(c))
    .get("/graph", c -> meta.graph(c))
    .get("/entities", c -> entities.list(c))
    .post("/entities", c -> entities.create(c))
    .get("/entities/:name", c -> entities.show(c))
    .patch("/entities/:name", c -> entities.rename(c))
    .delete("/entities/:name", c -> entities.delete(c))
    .post("/entities/:name/merge", c -> entities.merge(c))
    .post("/entities/:name/observations", c -> entities.add_observations(c))
    .delete(
      "/entities/:name/observations",
      c -> entities.remove_observations(c),
    )
    .get("/entities/:name/events", c -> events.list(c))
    .post("/entities/:name/events", c -> events.create(c))
    .delete("/events/:id", c -> events.delete(c))
    .post("/relations", c -> relations.create(c))
    .delete("/relations", c -> relations.delete(c))
    .get("/search", c -> search.search(c))
    .get("/mcp", c -> meta.mcp_stream_rejected(c))
    .post("/mcp", c -> meta.mcp(c))
end

@doc """
Checks a connection out of the pool, runs `work`, and always checks
the connection back in. The pool inspects the returned value and
replaces it when the connection is no longer idle, so callers never
need to discard. Checkout failure surfaces as `Unavailable`, which
renders 503.

The whole phase, checkout wait included, runs inside a `db.query`
span under `trace`, and an `Err` outcome marks the span as failed.
"""
fn with_db<T>(
  pool: Pool<Connection>,
  trace: Trace,
  work: fn (Connection) -> (Connection, Result<T, Error>),
) -> T ! Error

  attributes: Map<String, Attribute> = ["db.system": "postgresql"]
  try trace.span_result(
    "db.query",
    SpanKind.Internal,
    attributes,
    _ -> run_db(pool, work),
  )
end

priv fn run_db<T>(
  pool: Pool<Connection>,
  work: fn (Connection) -> (Connection, Result<T, Error>),
) -> T ! Error

  db = pool.checkout(CHECKOUT_MS)
    rescue _ -> fail Error.Unavailable("no database connection available")

  (db, outcome) = work(db)
  pool.checkin(db)
  try outcome
end

@doc """
Response builders shared by every controller. REST responses
pretty-print their JSON, matching the service's original wire shape.
"""
struct Render
  @doc """
  Builds an error `HTTP.Response` directly, for failures the worker
  hits before a `Conn` exists (unparseable or oversized requests).
  """
  fn raw(status: Status, message: String) -> Response
    text = JSON.encode(error_body(status, message), pretty())
    headers =
      Headers.new()
      .set("Content-Type", "application/json")
      .set("Content-Length", "#{text.byte_length()}")
    Response{body: text, headers: headers, status: status, version: "HTTP/1.1"}
  end

  @doc """
  Renders the service error shape: `{error, message, status}`.
  """
  fn failure(c: Conn, status: Status, message: String) -> Conn
    Render.json(c, status, error_body(status, message))
  end

  @doc """
  Maps a package `Error` onto the HTTP status it renders with.
  """
  fn from_error(c: Conn, e: Error) -> Conn
    status =
      match e
        Error.Database(_) -> Status.internal_server_error()
        Error.Duplicate(_) -> Status.new(409, "Conflict")
        Error.Embedding(_) -> Status.new(502, "Bad Gateway")
        Error.NotFound(_) -> Status.not_found()
        Error.Unavailable(_) -> Status.new(503, "Service Unavailable")
        Error.Validation(_) -> Status.bad_request()
      end

    Render.failure(c, status, e.message())
  end

  fn json<T: JSON.Encoding>(c: Conn, status: Status, body: T) -> Conn
    text = JSON.encode(body, pretty())
    c.resp(status, text).put_resp_header("Content-Type", "application/json")
  end

  fn no_content(c: Conn) -> Conn
    c.resp(Status.no_content(), "")
  end

  @doc """
  Adopts a prebuilt `HTTP.Response` (the MCP endpoint builds its own)
  into the conn.
  """
  fn http(c: Conn, response: Response) -> Conn
    c = c.resp(response.status, response.body)

    c.resp_body.empty?()
      ? c
      : c.put_resp_header("Content-Type", "application/json")
  end
end

priv fn error_body(status: Status, message: String) -> Json
  [
    "error": status.reason.to_json(), "message": message.to_json(),
    "status": status.code.to_json()
  ]
end

priv fn pretty -> JSON.EncodeOptions
  JSON.EncodeOptions{pretty?: true}
end

@doc """
Request parameter readers, failing with `Validation` (rendered as
400) on bad input.
"""
struct Params
  @doc """
  Reads the percent-decoded `:name` path parameter.
  """
  fn name(c: Conn) -> String ! Error
    URI.decode(c.param("name").or(""))
      rescue _ -> fail Error.Validation("malformed percent-encoding in path")
  end

  @doc """
  Reads the `:id` path parameter as an integer.
  """
  fn id(c: Conn) -> Int ! Error
    text = c.param("id").or("")

    text.to_int()
      rescue _ -> fail Error.Validation("id must be an integer, got '#{text}'")
  end

  @doc """
  Reads and bounds the `limit` and `offset` pagination parameters.
  """
  fn page(c: Conn) -> (Int, Int) ! Error
    limit = try Params.limit(c, DEFAULT_PAGE_LIMIT)
    offset = try Params.int(c, "offset", 0)

    if offset < 0
      fail Error.Validation("offset must not be negative")
    end

    (limit, offset)
  end

  @doc """
  Reads the `limit` query parameter, `default` when absent, and
  bounds it to the page rules.
  """
  fn limit(c: Conn, default: Int) -> Int ! Error
    limit = try Params.int(c, "limit", default)

    if limit < 1 or limit > MAX_PAGE_LIMIT
      fail Error.Validation("limit must be between 1 and #{MAX_PAGE_LIMIT}")
    end

    limit
  end

  fn int(c: Conn, name: String, default: Int) -> Int ! Error
    match c.query_param(name)
      Option.None -> default
      Option.Some(text) ->
        text.to_int()
          rescue _ -> fail Error.Validation("#{name} must be an integer, got '#{text}'")
    end
  end
end

priv fn authorized?(c: Conn, api_key: Option<String>) -> Bool
  match api_key
    Option.None ->
      true

    Option.Some(key) ->
      match c.get_header("Authorization")
        Option.Some(header) -> secure_equal?(header, "Bearer " <> key)
        Option.None -> false
      end
  end
end

# Compares the full strings even after a mismatch, so timing does
# not reveal how much of the key matched. Length still short-circuits.
priv fn secure_equal?(a: String, b: String) -> Bool
  if a.length() != b.length()
    return false
  end

  mismatches = 0

  for i in Range{start: 0, stop: a.length() - 1}
    if a.get(i) != b.get(i)
      mismatches = mismatches + 1
    end
  end

  mismatches == 0
end
