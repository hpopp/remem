alias Postgres.Connection
alias Postgres.Value

@doc """
Append-only log of search queries, one row per `GET /search`. The
log captures what callers wanted from the graph, which later feeds
relevance work (recency and frequency of topics) and upkeep (queries
that match nothing reveal gaps, entities no query ever surfaces are
prune candidates). Rows are never updated, so there is no
`updated_at`.
"""
struct SearchLog
  @doc """
  Records one search query.
  """
  fn record(conn: Connection, query: String) -> (Connection, Result<(), Error>)
    (conn, outcome) = conn.execute(
      "INSERT INTO search_log (query) VALUES ($1)",
      [Value.string(query)],
    )

    (conn, done(outcome))
  end

  @doc """
  Deletes up to `limit` rows older than `days`, returning how many
  went. The `Cleaner` calls this on its sweep timer.
  """
  fn prune(conn: Connection, days: Int, limit: Int)
    -> (Connection, Result<Int, Error>)

    (conn, outcome) = conn.execute("""
      DELETE FROM search_log
      WHERE id IN (
        SELECT id FROM search_log
        WHERE created_at < now() - ($1 * interval '1 day')
        LIMIT $2
      )
      """, [Value.int(days), Value.int(limit)])

    (conn, affected_rows(outcome))
  end
end
