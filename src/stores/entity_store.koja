alias JSON.Value as JSONValue
alias Postgres.Connection
alias Postgres.QueryResult
alias Postgres.Value

@doc """
One timestamped fact about an entity.
"""
struct Observation: JSON.Encoding
  content: String
  created_at: DateTime
  updated_at: DateTime

  @doc """
  Encode the observation as JSON.
  """
  fn to_json(self) -> JSON.Value
    [
      "content": self.content.to_json(),
      "created_at": self.created_at.to_string().to_json(),
      "updated_at": self.updated_at.to_string().to_json()
    ]
  end
end

@doc """
An entity in the memory graph: a named concept with timestamped
observation rows. `kind` serializes as `type` in the API, since
`type` is a Koja keyword.
"""
struct Entity: JSON.Encoding
  created_at: DateTime
  id: Int
  kind: String
  name: String
  observations: List<Observation>
  updated_at: DateTime

  @doc """
  Encode the entity as JSON.
  """
  fn to_json(self) -> JSON.Value
    [
      "name": self.name.to_json(), "type": self.kind.to_json(),
      "observations": JSON.Value.Array(self.observations.map(o -> o.to_json())),
      "created_at": self.created_at.to_string().to_json(),
      "updated_at": self.updated_at.to_string().to_json()
    ]
  end
end

@doc """
An entity without its observations, plus how many it holds. The
shape `GET /entities` and `list_entities` return.
"""
struct EntitySummary: JSON.Encoding
  created_at: DateTime
  kind: String
  name: String
  observation_count: Int
  updated_at: DateTime

  @doc """
  Encode the entity summary as JSON.
  """
  fn to_json(self) -> JSON.Value
    [
      "name": self.name.to_json(), "type": self.kind.to_json(),
      "observation_count": self.observation_count.to_json(),
      "created_at": self.created_at.to_string().to_json(),
      "updated_at": self.updated_at.to_string().to_json()
    ]
  end
end

@doc """
An observation still waiting for its embedding, with the entity
fields the embedding text needs.
"""
struct PendingObservation
  content: String
  id: Int
  kind: String
  name: String
end

@doc """
One observation that matched a search, with its Reciprocal Rank
Fusion score.
"""
struct ObservationHit: JSON.Encoding
  content: String
  score: Float

  @doc """
  Encode the observation hit as JSON.
  """
  fn to_json(self) -> JSON.Value
    ["content": self.content.to_json(), "score": self.score.to_json()]
  end
end

@doc """
One search hit: the entity, its fused score (larger is more
relevant), and the observations that matched. Fuzzy-only hits carry
no observations.
"""
struct SearchResult: JSON.Encoding
  kind: String
  name: String
  observations: List<ObservationHit>
  score: Float

  @doc """
  Encode the search result as JSON.
  """
  fn to_json(self) -> JSON.Value
    [
      "name": self.name.to_json(), "type": self.kind.to_json(),
      "score": self.score.to_json(),
      "observations": JSON.Value.Array(self.observations.map(o -> o.to_json()))
    ]
  end
end

@doc """
Data-access layer over the `entities` and `observations` tables.
Every operation threads the Postgres `Connection` through and returns
it alongside the outcome, so callers rebind. Driver errors wrap into
the package `Error` at this boundary.

Reads aggregate an entity's observation rows into one JSON column
(`json_agg`), and observation writes bind as `$n::jsonb` parameters,
so nothing parses Postgres array literals. Embeddings live on
observation rows and bind as pgvector text literals through
`$n::vector`. Observation mutations also touch the entity's
`updated_at`.
"""
struct EntityStore
  @doc """
  The Reciprocal Rank Fusion constant `k` for hybrid search.
  """
  const RRF_K: Int = 60

  @doc """
  The number of observations the semantic side of hybrid search
  ranks. Observations are finer grained than entity names, so this
  side looks deeper than the fuzzy side.
  """
  const SEMANTIC_CANDIDATES: Int = 60

  @doc """
  The number of entity names the fuzzy side of hybrid search ranks.
  """
  const FUZZY_CANDIDATES: Int = 20

  @doc """
  The largest number of matching observations a search returns for
  each entity.
  """
  const HITS_PER_ENTITY: Int = 5

  @doc """
  The largest number of names the near-duplicate guard reports.
  """
  const SIMILAR_LIMIT: Int = 5

  @doc """
  Insert a new entity with its observations and return it with the
  inserted `(id, content)` rows, which the caller embeds. Unless
  `confirm` is set, a name close to an existing one fails with
  `Duplicate` naming the matches.
  """
  fn create(
    conn: Connection,
    name: String,
    kind: String,
    observations: List<String>,
    confirm: Bool,
  ) -> (Connection, Result<(Entity, List<(Int, String)>), Error>)

    (conn, guarded) = guard_similar(conn, name, confirm)

    match guarded
      Result.Err(e) -> return (conn, Result.Err(e))
      Result.Ok(_) -> ()
    end

    (conn, outcome) = conn.execute(
      "INSERT INTO entities (name, type) VALUES ($1, $2) RETURNING id",
      [Value.string(name), Value.string(kind)],
    )

    entity_id =
      match inserted_id(outcome, "entity #{name} already exists")
        Result.Err(e) -> return (conn, Result.Err(e))
        Result.Ok(id) -> id
      end

    # An empty observations list inserts zero rows, so no branch.
    (conn, inserted) = insert_observations(conn, entity_id, observations)

    rows =
      match inserted
        Result.Err(e) -> return (conn, Result.Err(e))
        Result.Ok(list) -> list
      end

    (conn, found) = require_entity(conn, name)

    match found
      Result.Err(e) -> (conn, Result.Err(e))
      Result.Ok(entity) -> (conn, Result.Ok((entity, rows)))
    end
  end

  @doc """
  Find one entity by name.
  """
  fn find(conn: Connection, name: String)
    -> (Connection, Result<Option<Entity>, Error>)

    (conn, outcome) = conn.execute(
      "#{select_sql()} WHERE e.name = $1 GROUP BY e.id",
      [Value.string(name)],
    )

    (conn, first_entity(outcome))
  end

  @doc """
  Return one page of entity summaries, most observations first.
  `limit` and `offset` are validated by the router, so they
  interpolate as plain integers.
  """
  fn summaries(conn: Connection, limit: Int, offset: Int)
    -> (Connection, Result<List<EntitySummary>, Error>)

    (conn, outcome) = conn.query("""
    SELECT e.name, e.type, count(o.id)::int8,
      e.created_at::text, e.updated_at::text
    FROM entities e
    LEFT JOIN observations o ON o.entity_id = e.id
    GROUP BY e.id
    ORDER BY count(o.id) DESC, e.name
    LIMIT #{limit} OFFSET #{offset}
    """)

    (conn, summaries_from(outcome))
  end

  @doc """
  Return every entity, oldest first, for `GET /graph`.
  """
  fn all(conn: Connection) -> (Connection, Result<List<Entity>, Error>)
    (conn, outcome) = conn.query("#{select_sql()} GROUP BY e.id ORDER BY e.id")
    (conn, entities_from(outcome))
  end

  @doc """
  Delete an entity by name. Return `true` when a row was removed.
  Observations, events, and relations cascade in the database.
  """
  fn remove(conn: Connection, name: String) -> (Connection, Result<Bool, Error>)
    (conn, outcome) = conn.execute(
      "DELETE FROM entities WHERE name = $1",
      [Value.string(name)],
    )

    (conn, Database.Query.changed(outcome))
  end

  @doc """
  Rename an entity and touch its `updated_at`. Relations and
  events reference ids, so they follow. Observation and event
  embeddings carry the old name in their text, so they clear and the
  backfill recomputes them. Return the entity, or `None` for an
  unknown name. A taken name fails with `Duplicate`.
  """
  fn rename(conn: Connection, name: String, new_name: String)
    -> (Connection, Result<Option<Entity>, Error>)

    (conn, outcome) = conn.execute(
      "UPDATE entities SET name = $2, updated_at = now() WHERE name = $1 RETURNING id",
      [Value.string(name), Value.string(new_name)],
    )

    entity_id =
      match returned_id(outcome, "entity #{new_name} already exists")
        Result.Err(e) ->
          return (conn, Result.Err(e))

        Result.Ok(Option.None) ->
          missing: Option<Entity> = Option.None
          return (conn, Result.Ok(missing))

        Result.Ok(Option.Some(id)) ->
          id
      end

    (conn, cleared) = clear_embeddings(conn, entity_id)

    match cleared
      Result.Err(e) -> return (conn, Result.Err(e))
      Result.Ok(_) -> ()
    end

    (conn, cleared) = EventStore.clear_embeddings(conn, entity_id)

    match cleared
      Result.Err(e) -> return (conn, Result.Err(e))
      Result.Ok(_) -> ()
    end

    find(conn, new_name)
  end

  @doc """
  Fold `source` into `into` and delete `source`, in one transaction.
  Events move as they are. Observations move with their timestamps,
  except ones `into` already holds word for word. Relations rewire to
  `into`, except ones that would become self-loops or duplicate an
  existing relation. Moved events and observations clear their
  embeddings, since the text carries the entity name. Fail with
  `Validation` when the names match and `NotFound` when either is
  unknown. Return the target entity.
  """
  fn merge(conn: Connection, source: String, into: String)
    -> (Connection, Result<Entity, Error>)

    if source == into
      return (
        conn, Result.Err(Error.Validation("cannot merge an entity into itself"))
      )
    end

    (conn, found) = require_id(conn, source)

    source_id =
      match found
        Result.Err(e) -> return (conn, Result.Err(e))
        Result.Ok(id) -> id
      end

    (conn, found) = require_id(conn, into)

    target_id =
      match found
        Result.Err(e) -> return (conn, Result.Err(e))
        Result.Ok(id) -> id
      end

    (conn, began) = exec(conn, "BEGIN", List.new())

    match began
      Result.Err(e) -> return (conn, Result.Err(e))
      Result.Ok(_) -> ()
    end

    (conn, merged) = run_merge(conn, source_id, target_id)

    match merged
      Result.Err(e) ->
        (conn, _) = exec(conn, "ROLLBACK", List.new())
        return (conn, Result.Err(e))

      Result.Ok(_) ->
        ()
    end

    (conn, committed) = exec(conn, "COMMIT", List.new())

    match committed
      Result.Err(e) -> (conn, Result.Err(e))
      Result.Ok(_) -> require_entity(conn, into)
    end
  end

  @doc """
  Append observations an entity does not already hold (the unique
  `(entity_id, content)` constraint deduplicates) and touch the
  entity's `updated_at`. Return the updated entity with the inserted
  `(id, content)` rows, or `None` for an unknown name.
  """
  fn add_observations(
    conn: Connection,
    name: String,
    observations: List<String>,
  ) -> (Connection, Result<Option<(Entity, List<(Int, String)>)>, Error>)

    (conn, touched) = touch(conn, name)

    entity_id =
      match touched
        Result.Err(e) ->
          return (conn, Result.Err(e))

        Result.Ok(Option.None) ->
          missing: Option<(Entity, List<(Int, String)>)> = Option.None
          return (conn, Result.Ok(missing))

        Result.Ok(Option.Some(id)) ->
          id
      end

    (conn, inserted) = insert_observations(conn, entity_id, observations)

    rows =
      match inserted
        Result.Err(e) -> return (conn, Result.Err(e))
        Result.Ok(list) -> list
      end

    (conn, found) = require_entity(conn, name)

    match found
      Result.Err(e) -> (conn, Result.Err(e))
      Result.Ok(entity) -> (conn, Result.Ok(Option.Some((entity, rows))))
    end
  end

  @doc """
  Remove every observation matching one of the given strings and
  touch the entity's `updated_at`. Return the updated entity, or
  `None` for an unknown name.
  """
  fn remove_observations(
    conn: Connection,
    name: String,
    observations: List<String>,
  ) -> (Connection, Result<Option<Entity>, Error>)

    (conn, touched) = touch(conn, name)

    entity_id =
      match touched
        Result.Err(e) ->
          return (conn, Result.Err(e))

        Result.Ok(Option.None) ->
          missing: Option<Entity> = Option.None
          return (conn, Result.Ok(missing))

        Result.Ok(Option.Some(id)) ->
          id
      end

    (conn, deleted) = exec(conn, """
      DELETE FROM observations
      WHERE entity_id = $1
        AND content IN (SELECT jsonb_array_elements_text($2::jsonb))
      """, [
        Value.int(entity_id),
        Value.string(JsonUtil.encode_string_list(observations))
      ])

    match deleted
      Result.Err(e) -> (conn, Result.Err(e))
      Result.Ok(_) -> find(conn, name)
    end
  end

  @doc """
  Store freshly computed embeddings on observation rows by id, in one
  statement. `ids` and `vectors` pair up by position. Rows deleted
  mid-flight are skipped. Return the number of updated rows.
  """
  fn set_observation_embeddings(
    conn: Connection,
    ids: List<Int>,
    vectors: List<String>,
  ) -> (Connection, Result<Int, Error>)

    pairs: List<JSONValue> = List.new()

    for i in Range{start: 0, stop: ids.length() - 1}
      id = ids.get(i).or(0)
      vector = vectors.get(i).or("")
      pair: JSONValue = ["id": id.to_json(), "embedding": vector.to_json()]
      pairs = pairs.append(pair)
    end

    (conn, outcome) = conn.execute("""
      UPDATE observations o
      SET embedding = v.embedding::vector
      FROM jsonb_to_recordset($1::jsonb) AS v(id bigint, embedding text)
      WHERE o.id = v.id
      """, [Value.string(JSON.encode(JSONValue.Array(pairs)))])

    (conn, Database.Query.affected_rows(outcome))
  end

  @doc """
  Return up to `limit` observations with no embedding yet, oldest
  first, with their entity's name and type. The backfill drains this.
  """
  fn unembedded(conn: Connection, limit: Int)
    -> (Connection, Result<List<PendingObservation>, Error>)

    (conn, outcome) = conn.execute("""
      SELECT o.id, e.name, e.type, o.content
      FROM observations o
      JOIN entities e ON e.id = o.entity_id
      WHERE o.embedding IS NULL
      ORDER BY o.id
      LIMIT $1
      """, [Value.int(limit)])

    (conn, pending_from(outcome))
  end

  @doc """
  Return existing names close to `name`, closest first. A close name
  is trigram-similar or equal ignoring case. The near-duplicate guard
  uses the result.
  """
  fn similar_names(conn: Connection, name: String)
    -> (Connection, Result<List<String>, Error>)

    (conn, outcome) = conn.execute("""
      SELECT name FROM entities
      WHERE name % $1 OR lower(name) = lower($1)
      ORDER BY similarity(name, $1) DESC
      LIMIT #{EntityStore.SIMILAR_LIMIT}
      """, [Value.string(name)])

    (conn, names_from(outcome))
  end

  @doc """
  Run a hybrid search. With a query embedding, observations rank by
  cosine distance and entity names by trigram similarity. Both lists
  fuse by Reciprocal Rank Fusion and group by entity, where an
  entity's score is its best observation plus its name match. Each
  hit carries up to `EntityStore.HITS_PER_ENTITY` matching
  observations. Without an embedding (embedder down), trigram ranking
  runs alone. `limit` counts entities.
  """
  fn search(
    conn: Connection,
    query: String,
    embedding: Option<String>,
    limit: Int,
  ) -> (Connection, Result<List<SearchResult>, Error>)

    (conn, outcome) =
      match embedding
        Option.Some(vector) ->
          conn.execute(
            hybrid_sql(),
            [Value.string(vector), Value.string(query), Value.int(limit)],
          )

        Option.None ->
          conn.execute(fuzzy_sql(), [Value.string(query), Value.int(limit)])
      end

    (conn, results_from(outcome))
  end

  # Result columns: name, type, matching observations JSON, score.
  priv fn hybrid_sql -> String
    """
    WITH semantic AS (
      SELECT o.entity_id, o.content,
        ROW_NUMBER() OVER (ORDER BY o.embedding <=> $1::vector) AS rank
      FROM observations o
      WHERE o.embedding IS NOT NULL
      ORDER BY o.embedding <=> $1::vector
      LIMIT #{EntityStore.SEMANTIC_CANDIDATES}
    ), hits AS (
      SELECT entity_id, content,
        (1.0 / (#{EntityStore.RRF_K} + rank))::float8 AS score,
        ROW_NUMBER() OVER (PARTITION BY entity_id ORDER BY rank) AS entity_rank
      FROM semantic
    ), scored AS (
      SELECT entity_id AS id, MAX(score) AS score
      FROM hits
      GROUP BY entity_id
    ), fuzzy AS (
      SELECT id, ROW_NUMBER() OVER (ORDER BY similarity(name, $2) DESC) AS rank
      FROM entities
      WHERE name % $2
      ORDER BY similarity(name, $2) DESC
      LIMIT #{EntityStore.FUZZY_CANDIDATES}
    ), ranked AS (
      SELECT id,
        (COALESCE(s.score, 0) +
         COALESCE(1.0 / (#{EntityStore.RRF_K} + f.rank), 0))::float8 AS score
      FROM scored s
      FULL OUTER JOIN fuzzy f USING (id)
    )
    SELECT e.name, e.type,
      COALESCE((
        SELECT json_agg(
          json_build_object('content', h.content, 'score', h.score)
          ORDER BY h.score DESC
        )
        FROM hits h
        WHERE h.entity_id = e.id AND h.entity_rank <= #{EntityStore.HITS_PER_ENTITY}
      ), '[]')::text,
      r.score
    FROM ranked r
    JOIN entities e ON e.id = r.id
    ORDER BY r.score DESC, e.id
    LIMIT $3
    """
  end

  priv fn fuzzy_sql -> String
    """
    WITH ranked AS (
      SELECT id, similarity(name, $1)::float8 AS score
      FROM entities
      WHERE name % $1
    )
    SELECT e.name, e.type, '[]'::text, r.score
    FROM ranked r
    JOIN entities e ON e.id = r.id
    ORDER BY r.score DESC, e.id
    LIMIT $2
    """
  end

  # The statements inside a merge transaction. Any failure returns
  # early so `merge` can roll back.
  priv fn run_merge(conn: Connection, source_id: Int, target_id: Int)
    -> (Connection, Result<(), Error>)

    both = [Value.int(source_id), Value.int(target_id)]

    steps = [("""
        UPDATE events
        SET entity_id = $2, embedding = NULL
        WHERE entity_id = $1
        """, both), ("""
        UPDATE observations
        SET entity_id = $2, embedding = NULL
        WHERE entity_id = $1
          AND content NOT IN (SELECT content FROM observations WHERE entity_id = $2)
        """, both), ("""
        UPDATE relations r
        SET from_entity_id = $2
        WHERE r.from_entity_id = $1 AND r.to_entity_id <> $2
          AND NOT EXISTS (
            SELECT 1 FROM relations x
            WHERE x.from_entity_id = $2 AND x.to_entity_id = r.to_entity_id
              AND x.type = r.type
          )
        """, both), ("""
        UPDATE relations r
        SET to_entity_id = $2
        WHERE r.to_entity_id = $1 AND r.from_entity_id <> $2
          AND NOT EXISTS (
            SELECT 1 FROM relations x
            WHERE x.from_entity_id = r.from_entity_id AND x.to_entity_id = $2
              AND x.type = r.type
          )
        """, both),
      ("DELETE FROM entities WHERE id = $1", [Value.int(source_id)]),
      (
        "UPDATE entities SET updated_at = now() WHERE id = $1",
        [Value.int(target_id)]
      )]

    for step in steps
      (sql, params) = step
      (conn, outcome) = exec(conn, sql, params)

      match outcome
        Result.Err(e) -> return (conn, Result.Err(e))
        Result.Ok(_) -> ()
      end
    end

    (conn, Result.Ok(()))
  end

  # Inserts observation rows, skipping ones the entity already holds,
  # and returns the rows that landed.
  priv fn insert_observations(
    conn: Connection,
    entity_id: Int,
    observations: List<String>,
  ) -> (Connection, Result<List<(Int, String)>, Error>)

    (conn, outcome) = conn.execute("""
      INSERT INTO observations (entity_id, content)
      SELECT $1, t.x FROM jsonb_array_elements_text($2::jsonb) AS t(x)
      ON CONFLICT (entity_id, content) DO NOTHING
      RETURNING id, content
      """, [
        Value.int(entity_id),
        Value.string(JsonUtil.encode_string_list(observations))
      ])

    (conn, inserted_rows(outcome))
  end

  # The near-duplicate guard for `create`. Passes when `confirm` is
  # set or no existing name is close to `name`.
  priv fn guard_similar(conn: Connection, name: String, confirm: Bool)
    -> (Connection, Result<(), Error>)

    if confirm
      return (conn, Result.Ok(()))
    end

    (conn, similar) = similar_names(conn, name)
    (conn, no_similar(similar))
  end

  # Fails with `Duplicate` when the guard found close names.
  priv fn no_similar(similar: Result<List<String>, Error>) ! Error
    names = try similar

    if not names.empty?()
      fail Error.Duplicate("similar entities exist: " <>
        String.join(names, ", ") <> ". Pass confirm true to create anyway.")
    end
  end

  # Clears every observation embedding an entity holds, so the
  # backfill recomputes them under a new name.
  priv fn clear_embeddings(conn: Connection, entity_id: Int)
    -> (Connection, Result<(), Error>)

    exec(
      conn,
      "UPDATE observations SET embedding = NULL WHERE entity_id = $1",
      [Value.int(entity_id)],
    )
  end

  @doc """
  Touch an entity's `updated_at`. Return its id, or `None` for an
  unknown name. Mutations here and in `EventStore` also use this
  function as the existence check.
  """
  fn touch(conn: Connection, name: String)
    -> (Connection, Result<Option<Int>, Error>)

    (conn, outcome) = conn.execute(
      "UPDATE entities SET updated_at = now() WHERE name = $1 RETURNING id",
      [Value.string(name)],
    )

    (conn, first_id(outcome))
  end

  @doc """
  Unwrap a store outcome where `None` means the named entity is
  unknown. Fail with `NotFound` in that case.
  """
  fn required<T>(outcome: Result<Option<T>, Error>, name: String) -> T ! Error
    match try outcome
      Option.Some(value) -> value
      Option.None -> fail Error.NotFound("no entity named #{name}")
    end
  end

  # Resolves a name to its id, or `NotFound` for an unknown name.
  priv fn require_id(conn: Connection, name: String)
    -> (Connection, Result<Int, Error>)

    (conn, outcome) = conn.execute(
      "SELECT id FROM entities WHERE name = $1",
      [Value.string(name)],
    )

    (conn, required_id(outcome, name))
  end

  # Re-reads an entity that is known to exist, converting the
  # impossible miss into a database error.
  priv fn require_entity(conn: Connection, name: String)
    -> (Connection, Result<Entity, Error>)

    (conn, found) = find(conn, name)
    (conn, present(found, name))
  end

  priv fn exec(conn: Connection, sql: String, params: List<Value>)
    -> (Connection, Result<(), Error>)

    (conn, outcome) = conn.execute(sql, params)
    (conn, Database.Query.done(outcome))
  end

  # The id an INSERT ... RETURNING id produced. A unique violation
  # reads as `Duplicate` with the given description.
  priv fn inserted_id(
    outcome: Result<QueryResult, Postgres.Error>,
    duplicate: String,
  ) -> Int ! Error

    qr = outcome rescue e -> fail Error.from_postgres(e, duplicate)

    match qr.rows.get(0)
      Option.Some(row) -> Database.Row.int_at(row, 0)
      Option.None -> fail Error.Database("insert returned no row")
    end
  end

  # The id an UPDATE ... RETURNING id produced, or `None` when no row
  # matched. A unique violation reads as `Duplicate`.
  priv fn returned_id(
    outcome: Result<QueryResult, Postgres.Error>,
    duplicate: String,
  ) -> Option<Int> ! Error

    qr = outcome rescue e -> fail Error.from_postgres(e, duplicate)
    qr.rows.get(0).map(row -> Database.Row.int_at(row, 0))
  end

  # The id in the first row, or `None` when there is no row.
  priv fn first_id(outcome: Result<QueryResult, Postgres.Error>)
    -> Option<Int> ! Error

    qr = try Database.Query.result(outcome)
    qr.rows.get(0).map(row -> Database.Row.int_at(row, 0))
  end

  # The id in the first row, or `NotFound` when there is no row.
  priv fn required_id(
    outcome: Result<QueryResult, Postgres.Error>,
    name: String,
  ) -> Int ! Error

    qr = try Database.Query.result(outcome)

    match qr.rows.get(0)
      Option.Some(row) -> Database.Row.int_at(row, 0)
      Option.None -> fail Error.NotFound("no entity named #{name}")
    end
  end

  # An entity that a prior step proved exists.
  priv fn present(found: Result<Option<Entity>, Error>, name: String)
    -> Entity ! Error

    match try found
      Option.Some(entity) -> entity
      Option.None -> fail Error.Database("entity #{name} vanished mid-write")
    end
  end

  priv fn inserted_rows(outcome: Result<QueryResult, Postgres.Error>)
    -> List<(Int, String)> ! Error

    qr = try Database.Query.result(outcome)
    qr.rows.map(row -> (
      Database.Row.int_at(row, 0), Database.Row.text_at(row, 1)
    ))
  end

  priv fn names_from(outcome: Result<QueryResult, Postgres.Error>)
    -> List<String> ! Error

    qr = try Database.Query.result(outcome)
    qr.rows.map(row -> Database.Row.text_at(row, 0))
  end

  priv fn pending_from(outcome: Result<QueryResult, Postgres.Error>)
    -> List<PendingObservation> ! Error

    qr = try Database.Query.result(outcome)

    qr.rows.map(row -> PendingObservation{
      content: Database.Row.text_at(row, 3),
      id: Database.Row.int_at(row, 0),
      kind: Database.Row.text_at(row, 2),
      name: Database.Row.text_at(row, 1),
    })
  end

  priv fn results_from(outcome: Result<QueryResult, Postgres.Error>)
    -> List<SearchResult> ! Error

    qr = try Database.Query.result(outcome)

    qr.rows.map(row -> SearchResult{
      kind: Database.Row.text_at(row, 1),
      name: Database.Row.text_at(row, 0),
      observations: JsonUtil.decode_hits(Database.Row.text_at(row, 2)),
      score: row.get(3).map(v -> v.float_or(0.0)).or(0.0),
    })
  end

  priv fn first_entity(outcome: Result<QueryResult, Postgres.Error>)
    -> Option<Entity> ! Error

    qr = try Database.Query.result(outcome)

    match qr.rows.get(0)
      Option.None -> Option.None
      Option.Some(row) -> Option.Some(try row_to_entity(row))
    end
  end

  # Row mapping can fail on an unreadable timestamp, so these loop
  # with `try` instead of mapping.
  priv fn entities_from(outcome: Result<QueryResult, Postgres.Error>)
    -> List<Entity> ! Error

    qr = try Database.Query.result(outcome)
    entities: List<Entity> = List.new()

    for row in qr.rows
      entities = entities.append(try row_to_entity(row))
    end

    entities
  end

  priv fn summaries_from(outcome: Result<QueryResult, Postgres.Error>)
    -> List<EntitySummary> ! Error

    qr = try Database.Query.result(outcome)
    summaries: List<EntitySummary> = List.new()

    for row in qr.rows
      summaries = summaries.append(try row_to_summary(row))
    end

    summaries
  end

  priv fn row_to_entity(row: List<Value>) -> Entity ! Error
    Entity{
      created_at: try Database.Row.time(Database.Row.text_at(row, 4)),
      id: Database.Row.int_at(row, 0),
      kind: Database.Row.text_at(row, 2),
      name: Database.Row.text_at(row, 1),
      observations: try JsonUtil.decode_observations(
        Database.Row.text_at(row, 3),
      ),
      updated_at: try Database.Row.time(Database.Row.text_at(row, 5)),
    }
  end

  priv fn row_to_summary(row: List<Value>) -> EntitySummary ! Error
    EntitySummary{
      created_at: try Database.Row.time(Database.Row.text_at(row, 3)),
      kind: Database.Row.text_at(row, 1),
      name: Database.Row.text_at(row, 0),
      observation_count: Database.Row.int_at(row, 2),
      updated_at: try Database.Row.time(Database.Row.text_at(row, 4)),
    }
  end

  # Column order every entity read shares:
  # id, name, type, observations JSON, created_at, updated_at.
  # Callers append WHERE/JOIN clauses and must GROUP BY e.id.
  priv fn select_sql -> String
    """
    SELECT e.id, e.name, e.type,
      COALESCE(
        json_agg(
          json_build_object(
            'content', o.content,
            'created_at', o.created_at::text,
            'updated_at', o.updated_at::text
          ) ORDER BY o.id
        ) FILTER (WHERE o.id IS NOT NULL),
        '[]'
      )::text,
      e.created_at::text, e.updated_at::text
    FROM entities e
    LEFT JOIN observations o ON o.entity_id = e.id
    """
  end
end
