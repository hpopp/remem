alias Duration.Unit as TimeUnit
alias JSON.Value
alias Log.Attribute as LogAttribute
alias Log.Level
alias Log.Record
alias Test.require

# 2026-09-23T20:00:00.123456Z
priv const LOGGED_AT: Int = 1_790_193_600_123_456

struct CloudLoggingTest
  priv fn formatter -> CloudLogging
    CloudLogging{
      project_id: "example-project",
      service_name: "remem",
      service_version: "0.5.0",
    }
  end

  # A record stamped with the calling process's context, which is the
  # zero context unless the test opened a span.
  priv fn record(level: Level, attributes: Map<String, LogAttribute>) -> Record
    Record{
      attributes: attributes,
      context: Process.context(),
      level: level,
      message: "GET /entities 200 12ms",
      timestamp: Timestamp.new(LOGGED_AT, TimeUnit.Microseconds),
    }
  end

  # The expected side of a comparison with `JSON.get`. A literal
  # argument becomes the matching JSON value.
  priv fn some(value: Value) -> Option<Value>
    Option.Some(value)
  end

  priv fn render(level: Level, attributes: Map<String, LogAttribute>)
    -> Value ! String

    try JSON.decode(formatter().format_log(record(level, attributes)))
  end

  test "format_log writes the Cloud Logging special fields"
    object = try require(render(Level.Info, Map.new()))

    assert JSON.get(object, "severity") == some("INFO")
    assert JSON.get(object, "message") == some("GET /entities 200 12ms")
    assert JSON.get(object, "time") == some("2026-09-23T20:00:00.123456Z")
    assert JSON.get(object, "httpRequest") == Option.None
    assert JSON.get(object, "@type") == Option.None
    assert JSON.get(object, "serviceContext") == Option.None
  end

  test "format_log spells warn as WARNING"
    object = try require(render(Level.Warn, Map.new()))

    assert JSON.get(object, "severity") == some("WARNING")
  end

  test "format_log maps trace to DEBUG, the lowest Cloud Logging severity"
    object = try require(render(Level.Trace, Map.new()))

    assert JSON.get(object, "severity") == some("DEBUG")
  end

  test "format_log places other attributes at the top level"
    attributes: Map<String, LogAttribute> = [
      "mcp.tool": "search_memory",
      "n": 3
    ]
    object = try require(render(Level.Info, attributes))

    assert JSON.get(object, "mcp.tool") == some("search_memory")
    assert JSON.get(object, "n") == some(3)
  end

  test "format_log folds the HTTP attributes into httpRequest"
    attributes: Map<String, LogAttribute> = [
      "http.request.method": "GET",
      "url.path": "/entities",
      "http.response.status_code": 200,
      "http.server.request.duration": 12_345
    ]
    object = try require(render(Level.Info, attributes))
    request = JSON.get(object, "httpRequest").or(JSON.NULL)

    assert JSON.get(request, "requestMethod") == some("GET")
    assert JSON.get(request, "requestUrl") == some("/entities")
    assert JSON.get(request, "status") == some(200)
    assert JSON.get(request, "latency") == some("0.012345s")
    assert JSON.get(object, "http.request.method") == Option.None
    assert JSON.get(object, "url.path") == Option.None
    assert JSON.get(object, "http.response.status_code") == Option.None
    assert JSON.get(object, "http.server.request.duration") == Option.None
  end

  test "format_log writes a latency above one second"
    attributes: Map<String, LogAttribute> = [
      "http.server.request.duration": 2_500_000
    ]
    object = try require(render(Level.Info, attributes))
    request = JSON.get(object, "httpRequest").or(JSON.NULL)

    assert JSON.get(request, "latency") == some("2.500000s")
  end

  test "format_log marks an error for Error Reporting"
    object = try require(render(Level.Error, Map.new()))
    context = JSON.get(object, "serviceContext").or(JSON.NULL)

    assert JSON.get(object, "severity") == some("ERROR")
    assert JSON.get(object, "@type") ==
      some(
        "type.googleapis.com/google.devtools.clouderrorreporting.v1beta1.ReportedErrorEvent",
      )
    assert JSON.get(context, "service") == some("remem")
    assert JSON.get(context, "version") == some("0.5.0")
  end

  test "format_log writes no trace fields for a record nobody traced"
    object = try require(render(Level.Info, Map.new()))

    assert JSON.get(object, "logging.googleapis.com/trace") == Option.None
    assert JSON.get(object, "logging.googleapis.com/spanId") == Option.None
    assert JSON.get(object, "logging.googleapis.com/trace_sampled") ==
      Option.None
  end

  test "format_log links a record emitted under a span to its trace"
    (context, line) = Trace.root(
      "test",
      fn (span: Trace.Span) -> (Process.Context, String)
        (
          Process.context(),
          formatter().format_log(record(Level.Info, Map.new()))
        )
      end,
    )
    object = try require(JSON.decode(line))
    trace_id = Base.encode16(context.trace_id())
    span_id = Base.encode16(context.span_id())

    assert JSON.get(object, "logging.googleapis.com/trace") ==
      some("projects/example-project/traces/#{trace_id}")
    assert JSON.get(object, "logging.googleapis.com/spanId") == some(span_id)
    assert JSON.get(object, "logging.googleapis.com/trace_sampled") ==
      some(true)
  end
end
