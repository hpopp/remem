struct JsonUtilTest
  test "parse_entity reads name, type, and observations"
    body = "{\"name\": \"Koja\", \"type\": \"language\", " <>
      "\"observations\": [\"compiled\", \"friendly\"]}"

    (name, kind, observations) = JsonUtil.parse_entity(body)
      rescue e -> fail "expected Ok, got: #{e.message()}"

    assert name == "Koja"
    assert kind == "language"
    assert observations.length() == 2
  end

  test "parse_entity defaults observations to empty"
    (_, _, observations) = JsonUtil.parse_entity(
      "{\"name\": \"Koja\", \"type\": \"language\"}",
    )
      rescue e -> fail "expected Ok, got: #{e.message()}"

    assert observations.empty?()
  end

  test "parse_entity rejects a missing name"
    match JsonUtil.parse_entity("{\"type\": \"language\"}")
      Result.Err(Error.Validation(_)) -> ()
      Result.Err(e) -> fail "wrong error: #{e.message()}"
      Result.Ok(_) -> fail "expected an error"
    end
  end

  test "parse_entity rejects non-string observations"
    body = "{\"name\": \"x\", \"type\": \"y\", \"observations\": [1, 2]}"

    match JsonUtil.parse_entity(body)
      Result.Err(Error.Validation(_)) -> ()
      Result.Err(e) -> fail "wrong error: #{e.message()}"
      Result.Ok(_) -> fail "expected an error"
    end
  end

  test "parse_entity rejects malformed JSON"
    match JsonUtil.parse_entity("{nope")
      Result.Err(Error.Validation(_)) -> ()
      Result.Err(e) -> fail "wrong error: #{e.message()}"
      Result.Ok(_) -> fail "expected an error"
    end
  end

  test "parse_observations requires a non-empty array"
    match JsonUtil.parse_observations("{\"observations\": []}")
      Result.Err(Error.Validation(_)) -> ()
      Result.Err(e) -> fail "wrong error: #{e.message()}"
      Result.Ok(_) -> fail "expected an error"
    end
  end

  test "parse_relation reads from, to, and type"
    (from, to, kind) = JsonUtil.parse_relation(
      "{\"from\": \"a\", \"to\": \"b\", \"type\": \"knows\"}",
    )
      rescue e -> fail "expected Ok, got: #{e.message()}"

    assert from == "a"
    assert to == "b"
    assert kind == "knows"
  end

  test "decode_observations reads json_agg output"
    text = "[{\"content\": \"a \\\"quoted\\\" fact\", " <>
      "\"created_at\": \"2026-09-01 15:00:00+00\", " <>
      "\"updated_at\": \"2026-09-01 15:30:00+00\"}]"

    decoded = JsonUtil.decode_observations(text)
      rescue e -> fail "expected Ok, got: #{e.message()}"
    assert decoded.length() == 1

    observation =
      match decoded.first()
        Option.Some(o) -> o
        Option.None -> fail "missing observation"
      end

    assert observation.content == "a \"quoted\" fact"
    assert observation.created_at.to_string() == "2026-09-01T15:00:00Z"
    assert observation.updated_at.to_string() == "2026-09-01T15:30:00Z"
  end

  test "decode_observations fails on malformed text"
    match JsonUtil.decode_observations("{not json")
      Result.Err(Error.Database(_)) -> ()
      Result.Err(e) -> fail "wrong error: #{e.message()}"
      Result.Ok(_) -> fail "expected an error"
    end
  end

  test "decode_observations fails on an unreadable timestamp"
    text = "[{\"content\": \"x\", \"created_at\": \"yesterday\", " <>
      "\"updated_at\": \"2026-09-01 15:30:00+00\"}]"

    match JsonUtil.decode_observations(text)
      Result.Err(Error.Database(_)) -> ()
      Result.Err(e) -> fail "wrong error: #{e.message()}"
      Result.Ok(_) -> fail "expected an error"
    end
  end

  test "distinct keeps first occurrences in order"
    result = JsonUtil.distinct(["a", "b", "a", "c", "b"])

    assert result.length() == 3
    assert result.get(0) == Option.Some("a")
    assert result.get(1) == Option.Some("b")
    assert result.get(2) == Option.Some("c")
  end
end
