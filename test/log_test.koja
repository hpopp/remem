alias Duration.Unit as TimeUnit

struct LogTest
  test "elapsed picks the unit from the size"
    assert Log.elapsed(Duration.new(0, TimeUnit.Nanoseconds)) == "0µs"
    assert Log.elapsed(Duration.new(452, TimeUnit.Microseconds)) == "452µs"
    assert Log.elapsed(Duration.new(3_120, TimeUnit.Microseconds)) == "3ms"
    assert Log.elapsed(Duration.new(999, TimeUnit.Milliseconds)) == "999ms"
    assert Log.elapsed(Duration.new(1_234, TimeUnit.Milliseconds)) == "1.2s"
    assert Log.elapsed(Duration.new(75, TimeUnit.Seconds)) == "75.0s"
  end
end
