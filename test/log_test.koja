struct LogTest
  @test "iso8601 formats known timestamps"
  fn test_iso8601 -> Bool ! String
    unless Log.iso8601(0) == "1970-01-01T00:00:00.000Z"
      fail "epoch zero: " <> Log.iso8601(0)
    end

    # 2026-09-02 23:08:12.123 UTC
    unless Log.iso8601(1788390492123) == "2026-09-02T23:08:12.123Z"
      fail "modern date: " <> Log.iso8601(1788390492123)
    end

    # Leap day boundary: 2024-02-29 23:59:59.999 UTC
    unless Log.iso8601(1709251199999) == "2024-02-29T23:59:59.999Z"
      fail "leap day: " <> Log.iso8601(1709251199999)
    end

    true
  end
end
