alias HTTP.Headers
alias HTTP.Method
alias HTTP.Request
alias HTTP.Response
alias Pooler.Config as PoolConfig
alias Pooler.Pool
alias Postgres.Config as DbConfig
alias Postgres.Connection
alias Scout.Client

@doc """
Route table tests. The auth, rejection, and health tests run against
a router whose pool can never connect, which proves those paths
answer without a database connection.
"""
struct RouterTest
  test "auth middleware rejects requests before any pool checkout"
    router = Routes.build(
      broken_pool(),
      test_embedder(),
      Option.Some("test-key"),
    )

    response = router.dispatch(request(Method.Post, "/entities", ""))

    text = try body_text(response)

    assert response.status.code == 401, "a missing key should answer 401"
    assert text.contains?("missing or invalid API key"), "401 body should name the API key error"

    wrong = Headers.new().set("Authorization", "Bearer wrong-key")
    response = router.dispatch(
      request_with_headers(Method.Post, "/entities", "", wrong),
    )

    assert response.status.code == 401, "a wrong key should answer 401"
  end

  test "404 answers in the error shape without a pool checkout"
    router = Routes.build(
      broken_pool(),
      test_embedder(),
      Option.Some("test-key"),
    )

    response = router.dispatch(
      request_with_headers(Method.Get, "/.env", "", bearer()),
    )

    text = try body_text(response)

    assert response.status.code == 404
    assert text.contains?("no such route"), "404 body should say no such route"
  end

  test "405 lists the allowed methods in the error shape"
    router = Routes.build(
      broken_pool(),
      test_embedder(),
      Option.Some("test-key"),
    )

    response = router.dispatch(
      request_with_headers(Method.Put, "/entities", "{}", bearer()),
    )

    text = try body_text(response)

    assert response.status.code == 405
    assert response.headers.get("Allow") == Option.Some("GET, POST")
    assert text.contains?("PUT is not supported"), "405 body should name the method"
  end

  test "400 answers in the error shape for a malformed path"
    router = Routes.build(
      broken_pool(),
      test_embedder(),
      Option.Some("test-key"),
    )

    response = router.dispatch(
      request_with_headers(Method.Get, "/entities/%ff", "", bearer()),
    )

    text = try body_text(response)

    assert response.status.code == 400
    assert text.contains?("malformed encoding"), "400 body should name the encoding error"
  end

  test "GET /mcp answers 405 and points at POST"
    router = Routes.build(
      broken_pool(),
      test_embedder(),
      Option.Some("test-key"),
    )

    response = router.dispatch(
      request_with_headers(Method.Get, "/mcp", "", bearer()),
    )

    text = try body_text(response)

    assert response.status.code == 405
    assert text.contains?("POST JSON-RPC messages to /mcp"), "GET /mcp should point clients at POST"
  end

  test "GET /health stays exempt from auth and needs no database"
    router = Routes.build(
      broken_pool(),
      test_embedder(),
      Option.Some("test-key"),
    )

    # No Authorization header at all.
    response = router.dispatch(request(Method.Get, "/health", ""))

    text = try body_text(response)

    assert response.status.code == 200
    assert text.contains?("ok"), "health body should report ok"
  end

  test "DELETE /events/:id rejects a non-integer id before pool checkout"
    router = Routes.build(
      broken_pool(),
      test_embedder(),
      Option.Some("test-key"),
    )

    response = router.dispatch(
      request_with_headers(Method.Delete, "/events/abc", "", bearer()),
    )

    text = try body_text(response)

    assert response.status.code == 400
    assert text.contains?("id must be an integer"), "400 body should name the id error"
  end

  test "POST /entities/:name/events rejects malformed occurred_at before pool checkout"
    router = Routes.build(
      broken_pool(),
      test_embedder(),
      Option.Some("test-key"),
    )

    body = "{\"content\": \"shipped\", \"occurred_at\": \"yesterday\"}"
    response = router.dispatch(
      request_with_headers(Method.Post, "/entities/x/events", body, bearer()),
    )

    text = try body_text(response)

    assert response.status.code == 400
    assert text.contains?("occurred_at must be RFC 3339"), "400 body should name the occurred_at error"
  end

  test "a body that is not JSON answers 400 before pool checkout"
    router = Routes.build(
      broken_pool(),
      test_embedder(),
      Option.Some("test-key"),
    )

    response = router.dispatch(
      request_with_headers(Method.Post, "/entities", "{nope", bearer()),
    )

    text = try body_text(response)

    assert response.status.code == 400
    assert text.contains?("malformed JSON body"), "400 body should name the JSON error"
  end

  test "a body that is not UTF-8 answers 400 before pool checkout"
    router = Routes.build(
      broken_pool(),
      test_embedder(),
      Option.Some("test-key"),
    )

    upload = request_with_headers(Method.Post, "/entities", "", bearer())
    upload.body = <<255, 0, 254>>
    response = router.dispatch(upload)

    text = try body_text(response)

    assert response.status.code == 400
    assert text.contains?("request body is not valid UTF-8"), "400 body should name the UTF-8 error"
  end

  test "POST /mcp answers a JSON-RPC parse error before pool checkout"
    router = Routes.build(
      broken_pool(),
      test_embedder(),
      Option.Some("test-key"),
    )

    response = router.dispatch(
      request_with_headers(Method.Post, "/mcp", "{nope", bearer()),
    )

    text = try body_text(response)

    assert response.status.code == 200
    assert text.contains?("-32700"), "the reply should carry the parse error code"
  end

  test "search log prune deletes at most the sweep bound"
    conn = try connect()
    conn = Migrator.run(conn) rescue e -> fail "migrate: #{e.message()}"
    conn = try clear_prune_rows(conn)

    for i in Range{start: 0, stop: 2}
      (conn, outcome) = conn.query("""
      INSERT INTO search_log (query, created_at)
      VALUES ('itest-prune', now() - interval '100 days')
      """)

      match outcome
        Result.Err(e) -> fail "seed: #{e.message()}"
        Result.Ok(_) -> ()
      end
    end

    (conn, pruned) = SearchLog.prune(conn, 90, 2)
    first = pruned rescue e -> fail "first prune: #{e.message()}"
    assert first == 2

    (conn, pruned) = SearchLog.prune(conn, 90, 2)
    second = pruned rescue e -> fail "second prune: #{e.message()}"
    assert second == 1

    conn = try clear_prune_rows(conn)

    match conn.close()
      _ -> ()
    end
  end

  priv fn request(method: Method, path: String, body: String) -> Request
    request_with_headers(method, path, body, Headers.new())
  end

  priv fn request_with_headers(
    method: Method,
    path: String,
    body: String,
    headers: Headers,
  ) -> Request

    Request{
      body: body.to_binary(),
      headers: headers,
      method: method,
      uri: URI{
        fragment: Option.None,
        host: Option.None,
        path: path,
        port: Option.None,
        query: Option.None,
        scheme: Option.None,
        userinfo: Option.None,
      },
    }
  end

  priv fn body_text(response: Response) -> String ! Test.Failure
    response.text() rescue _ -> fail "response body is not UTF-8"
  end

  priv fn bearer -> Headers
    Headers.new().set("Authorization", "Bearer test-key")
  end

  # A stopped pool. Any checkout attempt reports PoolDown, so a test
  # that passes against it never touched the database. The factory
  # fails rather than connect, and the pool logs that once before it
  # stops.
  priv fn broken_pool -> Pool<Connection>
    create =
      fn () -> Result<Connection, String>
        broken: Result<Connection, String> = Result.Err("no database in test")
        broken
      end

    pool = Pool.start(PoolConfig{create: create, size: 1}).unwrap()
    _ = pool.stop()
    pool
  end

  priv fn test_embedder -> Embedder
    Embedder{client: Client.start().unwrap(), url: "http://127.0.0.1:1"}
  end

  priv fn connect -> Connection ! Test.Failure
    config = DbConfig.new("127.0.0.1", 5435, "postgres", "remem")

    Connection.connect(config)
      rescue e -> fail "connect (is docker compose up?): #{e.message()}"
  end

  priv fn clear_prune_rows(conn: Connection) -> Connection ! Test.Failure
    (conn, outcome) = conn.query(
      "DELETE FROM search_log WHERE query = 'itest-prune'",
    )

    match outcome
      Result.Err(e) -> fail "cleanup: #{e.message()}"
      Result.Ok(_) -> conn
    end
  end
end
