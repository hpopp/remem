alias Conn.Conn
alias HTTP.Headers
alias HTTP.Method
alias HTTP.Request
alias Pooler.Config as PoolConfig
alias Pooler.Pool
alias Postgres.Config as DbConfig
alias Postgres.Connection

@doc """
Route table and worker framing tests. Middleware tests (auth, method
guard, 404 fallback) run against a router whose pool can never
connect, which proves those paths answer without a database
connection. The health test uses the compose Postgres (port 5435).
"""
struct RouterTest
  @test "auth middleware rejects requests before any pool checkout"
  fn test_auth_rejects -> Bool ! String
    router = build_router(
      broken_pool(),
      test_embedder(),
      Option.Some("test-key"),
    )

    response = router.dispatch(request(Method.Post, "/entities", ""))

    unless response.status.code == 401
      fail "a missing key should answer 401, got #{response.status.code}"
    end

    unless response.body.contains?("missing or invalid API key")
      fail "401 body should name the API key error"
    end

    wrong = Headers.new().set("Authorization", "Bearer wrong-key")
    response = router.dispatch(
      request_with_headers(Method.Post, "/entities", "", wrong),
    )

    unless response.status.code == 401
      fail "a wrong key should answer 401, got #{response.status.code}"
    end

    true
  end

  @test "404 fallback answers without a pool checkout"
  fn test_not_found -> Bool ! String
    router = build_router(
      broken_pool(),
      test_embedder(),
      Option.Some("test-key"),
    )

    response = router.dispatch(
      request_with_headers(Method.Get, "/.env", "", bearer()),
    )

    unless response.status.code == 404
      fail "expected 404, got #{response.status.code}"
    end

    unless response.body.contains?("no such route")
      fail "404 body should say no such route"
    end

    true
  end

  @test "method guard answers 405 for verbs no route uses"
  fn test_method_guard -> Bool ! String
    router = build_router(
      broken_pool(),
      test_embedder(),
      Option.Some("test-key"),
    )

    response = router.dispatch(
      request_with_headers(Method.Put, "/entities", "{}", bearer()),
    )

    unless response.status.code == 405
      fail "expected 405, got #{response.status.code}"
    end

    true
  end

  @test "GET /mcp answers 405 and points at POST"
  fn test_mcp_get -> Bool ! String
    router = build_router(
      broken_pool(),
      test_embedder(),
      Option.Some("test-key"),
    )

    response = router.dispatch(
      request_with_headers(Method.Get, "/mcp", "", bearer()),
    )

    unless response.status.code == 405
      fail "expected 405, got #{response.status.code}"
    end

    unless response.body.contains?("POST JSON-RPC messages to /mcp")
      fail "GET /mcp should point clients at POST"
    end

    true
  end

  @test "GET /health stays exempt from auth, against compose Postgres"
  fn test_health_exempt -> Bool ! String
    create =
      fn () -> Result<Connection, String>
        config = DbConfig.new("127.0.0.1", 5435, "postgres", "remem")
        Connection.connect(config).map_err(e -> e.message())
      end

    pool = Pool.start(PoolConfig{create: create, size: 1})
    router = build_router(pool, test_embedder(), Option.Some("test-key"))

    # No Authorization header at all.
    response = router.dispatch(request(Method.Get, "/health", ""))

    unless response.status.code == 200
      fail "expected 200 (is docker compose up?), got #{response.status.code}"
    end

    unless response.body.contains?("ok")
      fail "health body should report ok"
    end

    true
  end

  @test "path params percent-decode and reject malformed encoding"
  fn test_name_param -> Bool ! String
    c = Conn.from_request(request(Method.Get, "/entities/x", ""))
    c.path_params = [("name", "Foo%20Bar")]

    decoded = Params.name(c) rescue e -> fail "decode: " <> e.message()

    unless decoded == "Foo Bar"
      fail "expected 'Foo Bar', got '#{decoded}'"
    end

    c.path_params = [("name", "%zz")]

    outcome = Params.name(c) rescue e -> match e
        Error.Validation(_) -> "__rejected__"
        _ -> fail "expected Validation, got " <> e.message()
      end

    unless outcome == "__rejected__"
      fail "malformed encoding should fail, got '#{outcome}'"
    end

    true
  end

  @test "search log prune deletes at most the sweep bound"
  fn test_prune_bound -> Bool ! String
    conn = try connect()
    conn = Migrator.run(conn) rescue e -> fail "migrate: " <> e.message()
    conn = try clear_prune_rows(conn)

    for i in Range{start: 0, stop: 2}
      (conn, outcome) = conn.query("""
      INSERT INTO search_log (query, created_at)
      VALUES ('itest-prune', now() - interval '100 days')
      """)

      match outcome
        Result.Err(e) -> fail "seed: " <> e.message()
        Result.Ok(_) -> ()
      end
    end

    (conn, pruned) = SearchLog.prune(conn, 90, 2)

    first = pruned rescue e -> fail "first prune: " <> e.message()

    unless first == 2
      fail "expected 2 pruned rows, got #{first}"
    end

    (conn, pruned) = SearchLog.prune(conn, 90, 2)

    second = pruned rescue e -> fail "second prune: " <> e.message()

    unless second == 1
      fail "expected 1 pruned row, got #{second}"
    end

    conn = try clear_prune_rows(conn)

    match conn.close()
      _ -> ()
    end

    true
  end

  priv fn request(method: Method, path: String, body: String) -> Request
    request_with_headers(method, path, body, Headers.new())
  end

  priv fn request_with_headers(
    method: Method,
    path: String,
    body: String,
    headers: Headers,
  ) -> Request

    Request{
      body: body,
      headers: headers,
      method: method,
      path: path,
      version: "HTTP/1.1",
    }
  end

  priv fn bearer -> Headers
    Headers.new().set("Authorization", "Bearer test-key")
  end

  # A pool whose factory always fails. Any checkout attempt reports
  # PoolDown, so a test that passes against it never touched the
  # database.
  priv fn broken_pool -> Pool<Connection>
    create =
      fn () -> Result<Connection, String>
        broken: Result<Connection, String> = Result.Err("no database in test")
        broken
      end

    Pool.start(PoolConfig{create: create, size: 1})
  end

  priv fn test_embedder -> Embedder
    Embedder{url: "http://127.0.0.1:1"}
  end

  priv fn connect -> Connection ! String
    config = DbConfig.new("127.0.0.1", 5435, "postgres", "remem")

    Connection.connect(config)
      rescue e -> fail "connect (is docker compose up?): " <> e.message()
  end

  priv fn clear_prune_rows(conn: Connection) -> Connection ! String
    (conn, outcome) = conn.query(
      "DELETE FROM search_log WHERE query = 'itest-prune'",
    )

    match outcome
      Result.Err(e) -> fail "cleanup: " <> e.message()
      Result.Ok(_) -> conn
    end
  end
end
