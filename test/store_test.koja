alias Postgres.Config as DbConfig
alias Postgres.Connection

@doc """
Integration tests against the compose Postgres (port 5435). Start it
with `docker compose up -d` before `koja test`. Test entities use the
`itest-` prefix and are removed at both ends of the run.
"""
struct StoreTest
  @test "entity and relation lifecycle against compose Postgres"
  fn test_lifecycle ! String
    conn = try connect()
    conn = Migrator.run(conn) rescue e -> fail "migrate: " <> e.message()
    conn = try cleanup(conn)

    # Create two entities. The shared database may hold similar names,
    # so both confirm. The guard gets its own check below.
    (conn, created) = EntityStore.create(
      conn,
      "itest-koja",
      "language",
      ["compiled to native binaries"],
      true,
    )
    (koja, koja_rows) = created rescue e -> fail "create koja: " <> e.message()

    if not (koja.name == "itest-koja" and koja.kind == "language")
      fail "created entity has wrong fields"
    end

    if koja_rows.length() != 1
      fail "expected 1 inserted row, got #{koja_rows.length()}"
    end

    (conn, created) = EntityStore.create(
      conn,
      "itest-postgres",
      "database",
      ["stores rows"],
      true,
    )
    (postgres_entity, postgres_rows) = created
      rescue e -> fail "create postgres: " <> e.message()

    if postgres_entity.kind != "database"
      fail "created postgres entity has wrong type"
    end

    # Duplicate names are conflicts.
    (conn, duplicate) = EntityStore.create(
      conn,
      "itest-koja",
      "language",
      List.new(),
      true,
    )

    match duplicate
      Result.Err(Error.Duplicate(_)) -> ()
      Result.Err(e) -> fail "wrong duplicate error: " <> e.message()
      Result.Ok(_) -> fail "duplicate create should fail"
    end

    # Near-duplicate names are refused without confirm.
    (conn, similar) = EntityStore.create(
      conn,
      "Itest Koja",
      "language",
      List.new(),
      false,
    )

    match similar
      Result.Err(Error.Duplicate(message)) ->
        if not message.contains?("itest-koja")
          fail "guard did not name the similar entity: " <> message
        end

      Result.Err(e) ->
        fail "wrong near-duplicate error: " <> e.message()

      Result.Ok(_) ->
        fail "near-duplicate create should fail without confirm"
    end

    # Observations append (deduplicated) and only new rows come back.
    (conn, updated) = EntityStore.add_observations(
      conn,
      "itest-koja",
      ["compiled to native binaries", "value semantics"],
    )

    maybe = updated rescue e -> fail "add observations: " <> e.message()

    (entity, added_rows) =
      match maybe
        Option.None -> fail "entity vanished"
        Option.Some(present) -> present
      end

    if entity.observations.length() != 2
      fail "expected 2 observations, got #{entity.observations.length()}"
    end

    if added_rows.length() != 1
      fail "expected 1 new row, got #{added_rows.length()}"
    end

    (conn, removed_obs) = EntityStore.remove_observations(
      conn,
      "itest-koja",
      ["compiled to native binaries"],
    )

    maybe_entity = removed_obs
      rescue e -> fail "remove observations: " <> e.message()

    entity =
      match maybe_entity
        Option.None -> fail "entity vanished"
        Option.Some(present) -> present
      end

    if entity.observations.length() != 1
      fail "expected 1 observation, got #{entity.observations.length()}"
    end

    # Relations: create, duplicate conflict, unknown entity.
    (conn, related) = RelationStore.create(
      conn,
      "itest-koja",
      "itest-postgres",
      "talks_to",
    )
    relation = related rescue e -> fail "create relation: " <> e.message()

    if not (relation.from == "itest-koja" and relation.kind == "talks_to")
      fail "created relation has wrong fields"
    end

    (conn, again) = RelationStore.create(
      conn,
      "itest-koja",
      "itest-postgres",
      "talks_to",
    )

    match again
      Result.Err(Error.Duplicate(_)) -> ()
      Result.Err(e) -> fail "wrong relation duplicate error: " <> e.message()
      Result.Ok(_) -> fail "duplicate relation should fail"
    end

    (conn, missing) = RelationStore.create(
      conn,
      "itest-koja",
      "itest-ghost",
      "haunts",
    )

    match missing
      Result.Err(Error.NotFound(_)) -> ()
      Result.Err(e) -> fail "wrong missing-entity error: " <> e.message()
      Result.Ok(_) -> fail "relation to unknown entity should fail"
    end

    (conn, touching) = RelationStore.for_entity(conn, "itest-koja")
    relations = touching rescue e -> fail "for_entity: " <> e.message()

    if relations.length() != 1
      fail "expected 1 relation, got #{relations.length()}"
    end

    # Fuzzy search finds a typo'd name without any embeddings.
    (conn, found) = EntityStore.search(conn, "itest-kojaa", Option.None, 10)
    results = found rescue e -> fail "fuzzy search: " <> e.message()

    if not results.any?(r -> r.name == "itest-koja")
      fail "fuzzy search missed itest-koja"
    end

    # Embed only the postgres observation. koja stays unembedded, so
    # it can only surface through its name.
    (postgres_row_id, _) =
      match postgres_rows.first()
        Option.None -> fail "postgres create returned no rows"
        Option.Some(row) -> row
      end

    (conn, stored) = EntityStore.set_observation_embeddings(
      conn,
      [postgres_row_id],
      [axis_vector(1)],
    )

    match stored
      Result.Err(e) ->
        fail "set_observation_embeddings: " <> e.message()

      Result.Ok(count) ->
        if count != 1
          fail "expected 1 embedded row, got #{count}"
        end
    end

    # Hybrid search with no name overlap returns only the entity with
    # a semantic hit, carrying just the observation that matched.
    (conn, found) = EntityStore.search(
      conn,
      "no-name-overlap",
      Option.Some(axis_vector(1)),
      10,
    )
    results = found rescue e -> fail "hybrid search: " <> e.message()

    top =
      match results.first()
        Option.None -> fail "hybrid search returned nothing"
        Option.Some(hit) -> hit
      end

    if top.name != "itest-postgres"
      fail "expected itest-postgres first, got " <> top.name
    end

    if top.observations.length() != 1
      fail "expected 1 matching observation, got #{top.observations.length()}"
    end

    if not top.observations.any?(o -> o.content == "stores rows")
      fail "hit carries the wrong observation"
    end

    if not results.all?(r -> r.name != "itest-koja")
      fail "unembedded itest-koja should not appear without a name match"
    end

    # A query both names match ranks the semantic hit first, and the
    # name-only hit comes back with no observations.
    (conn, found) = EntityStore.search(
      conn,
      "itest",
      Option.Some(axis_vector(1)),
      10,
    )
    results = found rescue e -> fail "mixed search: " <> e.message()

    top =
      match results.first()
        Option.None -> fail "mixed search returned nothing"
        Option.Some(hit) -> hit
      end

    if top.name != "itest-postgres"
      fail "expected itest-postgres first in mixed search, got " <> top.name
    end

    koja_hit =
      match results.find(r -> r.name == "itest-koja")
        Option.None -> fail "mixed search missed itest-koja by name"
        Option.Some(hit) -> hit
      end

    if not koja_hit.observations.empty?()
      fail "name-only hit should carry no observations"
    end

    # Deleting an entity cascades its relations.
    (conn, removed) = EntityStore.remove(conn, "itest-postgres")
    deleted = removed rescue e -> fail "remove: " <> e.message()

    if not deleted
      fail "expected a deleted row"
    end

    (conn, touching) = RelationStore.for_entity(conn, "itest-koja")
    relations = touching rescue e -> fail "for_entity after: " <> e.message()

    if not relations.empty?()
      fail "relations should cascade on entity delete"
    end

    conn = try cleanup(conn)

    match conn.close()
      _ -> ()
    end
  end

  @test "merge, rename, summaries, and the near-duplicate guard"
  fn test_curation ! String
    conn = try connect()
    conn = Migrator.run(conn) rescue e -> fail "migrate: " <> e.message()
    conn = try cleanup(conn)

    (conn, created) = EntityStore.create(
      conn,
      "itest-merge-a",
      "tool",
      ["alpha fact", "shared fact"],
      true,
    )
    (_, source_rows) = created
      rescue e -> fail "seed itest-merge-a: " <> e.message()

    conn = try seed(conn, "itest-merge-b", ["shared fact", "beta fact"])
    conn = try seed(conn, "itest-merge-c", List.new())

    # Relations that exercise every rewiring rule. a->c duplicates
    # b->c after the merge, a->b becomes a self-loop, c->a rewires.
    conn = try relate(conn, "itest-merge-a", "itest-merge-c", "uses")
    conn = try relate(conn, "itest-merge-b", "itest-merge-c", "uses")
    conn = try relate(conn, "itest-merge-a", "itest-merge-b", "likes")
    conn = try relate(conn, "itest-merge-c", "itest-merge-a", "made_by")

    # Embed the observation that will move, to check it clears.
    (conn, found) = EntityStore.find(conn, "itest-merge-a")
    source = try required(found, "itest-merge-a")

    alpha_created_at =
      match source.observations.find(o -> o.content == "alpha fact")
        Option.None -> fail "seed lost alpha fact"
        Option.Some(o) -> o.created_at
      end

    alpha_id =
      match source_rows.find(r -> content_of(r) == "alpha fact")
        Option.None -> fail "seed did not return alpha fact"
        Option.Some(r) -> id_of(r)
      end

    (conn, stored) = EntityStore.set_observation_embeddings(
      conn,
      [alpha_id],
      [axis_vector(0)],
    )
    _ = stored rescue e -> fail "set_observation_embeddings: " <> e.message()

    # Similar names are found in either direction of case and
    # punctuation.
    (conn, similar) = EntityStore.similar_names(conn, "Itest Merge A")
    names = similar rescue e -> fail "similar_names: " <> e.message()

    if not names.any?(n -> n == "itest-merge-a")
      fail "similar_names missed itest-merge-a"
    end

    # Merge validation.
    (conn, self_merge) = EntityStore.merge(
      conn,
      "itest-merge-a",
      "itest-merge-a",
    )

    match self_merge
      Result.Err(Error.Validation(_)) -> ()
      Result.Err(e) -> fail "wrong self-merge error: " <> e.message()
      Result.Ok(_) -> fail "self-merge should fail"
    end

    (conn, ghost_merge) = EntityStore.merge(
      conn,
      "itest-merge-a",
      "itest-ghost",
    )

    match ghost_merge
      Result.Err(Error.NotFound(_)) -> ()
      Result.Err(e) -> fail "wrong unknown-target error: " <> e.message()
      Result.Ok(_) -> fail "merge into unknown entity should fail"
    end

    # The merge itself.
    (conn, merged) = EntityStore.merge(conn, "itest-merge-a", "itest-merge-b")
    target = merged rescue e -> fail "merge: " <> e.message()

    if target.name != "itest-merge-b"
      fail "merge returned " <> target.name
    end

    if target.observations.length() != 3
      fail "expected 3 observations after merge, got #{target.observations.length()}"
    end

    match target.observations.find(o -> o.content == "alpha fact")
      Option.None ->
        fail "alpha fact did not move"

      Option.Some(o) ->
        if o.created_at != alpha_created_at
          fail "moved observation lost its created_at"
        end
    end

    (conn, found) = EntityStore.find(conn, "itest-merge-a")
    gone = found rescue e -> fail "find source: " <> e.message()

    if not gone.none?()
      fail "source survived the merge"
    end

    (conn, touching) = RelationStore.for_entity(conn, "itest-merge-b")
    relations = touching rescue e -> fail "for_entity: " <> e.message()

    if relations.length() != 2
      fail "expected 2 relations after merge, got #{relations.length()}"
    end

    if not relations.any?(r -> r.from == "itest-merge-b" and r.kind == "uses")
      fail "b -[uses]-> c should survive"
    end

    if not relations.any?(r -> r.to == "itest-merge-b" and r.kind == "made_by")
      fail "c -[made_by]-> a should rewire to b"
    end

    if not relations.all?(r -> r.kind != "likes")
      fail "self-loop should drop"
    end

    # The moved observation lost its embedding. The shared database
    # may hold many pending rows, so ask for plenty.
    (conn, pending) = EntityStore.unembedded(conn, 100000)
    rows = pending rescue e -> fail "unembedded after merge: " <> e.message()

    if not rows.any?(r -> r.content == "alpha fact"
      and r.name == "itest-merge-b")

      fail "moved observation should be pending an embedding"
    end

    # Rename keeps relations and refuses taken names.
    (conn, renamed) = EntityStore.rename(conn, "itest-merge-b", "itest-merge-z")
    maybe = renamed rescue e -> fail "rename: " <> e.message()

    match maybe
      Option.None ->
        fail "rename lost the entity"

      Option.Some(entity) ->
        if entity.name != "itest-merge-z"
          fail "rename returned " <> entity.name
        end
    end

    (conn, touching) = RelationStore.for_entity(conn, "itest-merge-z")
    relations = touching rescue e -> fail "for_entity renamed: " <> e.message()

    if relations.length() != 2
      fail "expected 2 relations after rename, got #{relations.length()}"
    end

    (conn, taken) = EntityStore.rename(conn, "itest-merge-z", "itest-merge-c")

    match taken
      Result.Err(Error.Duplicate(_)) -> ()
      Result.Err(e) -> fail "wrong taken-name error: " <> e.message()
      Result.Ok(_) -> fail "rename onto a taken name should fail"
    end

    (conn, unknown) = EntityStore.rename(conn, "itest-ghost", "itest-anything")
    nobody = unknown rescue e -> fail "rename unknown: " <> e.message()

    if not nobody.none?()
      fail "renaming an unknown entity returned one"
    end

    # Summaries carry counts, no observations, biggest first.
    (conn, listed) = EntityStore.summaries(conn, 1000, 0)
    summaries = listed rescue e -> fail "summaries: " <> e.message()

    z =
      match summaries.find(s -> s.name == "itest-merge-z")
        Option.None -> fail "summaries missed itest-merge-z"
        Option.Some(s) -> s
      end

    if not (z.observation_count == 3 and z.kind == "tool")
      fail "summary for itest-merge-z is wrong"
    end

    c =
      match summaries.find(s -> s.name == "itest-merge-c")
        Option.None -> fail "summaries missed itest-merge-c"
        Option.Some(s) -> s
      end

    if c.observation_count != 0
      fail "summary for itest-merge-c should count 0"
    end

    conn = try cleanup(conn)

    match conn.close()
      _ -> ()
    end
  end

  @test "search log records queries with timestamps"
  fn test_search_log ! String
    conn = try connect()
    conn = Migrator.run(conn) rescue e -> fail "migrate: " <> e.message()

    (conn, logged) = SearchLog.record(conn, "itest-query")

    match logged
      Result.Err(e) -> fail "record: " <> e.message()
      Result.Ok(_) -> ()
    end

    (conn, outcome) = conn.query("""
    SELECT count(*)::int, max(created_at::text)
    FROM search_log
    WHERE query = 'itest-query'
    """)

    qr =
      match outcome
        Result.Err(e) -> fail "select: " <> e.message()
        Result.Ok(result) -> result
      end

    row =
      match qr.rows.first()
        Option.None -> fail "count query returned nothing"
        Option.Some(present) -> present
      end

    if row.get(0).map(v -> v.int_or(0)).or(0) < 1
      fail "expected a logged query row"
    end

    if row.get(1).map(v -> v.string_or("")).or("").empty?()
      fail "logged query has no created_at"
    end

    (conn, outcome) = conn.query(
      "DELETE FROM search_log WHERE query = 'itest-query'",
    )

    match outcome
      Result.Err(e) -> fail "log cleanup: " <> e.message()
      Result.Ok(_) -> ()
    end

    match conn.close()
      _ -> ()
    end
  end

  # Creates a `tool` entity, bypassing the near-duplicate guard since
  # the fixtures share a prefix.
  priv fn seed(conn: Connection, name: String, observations: List<String>)
    -> Connection ! String

    (conn, created) = EntityStore.create(conn, name, "tool", observations, true)

    match created
      Result.Err(e) -> fail "seed #{name}: " <> e.message()
      Result.Ok(_) -> conn
    end
  end

  priv fn id_of(row: (Int, String)) -> Int
    (id, _) = row
    id
  end

  priv fn content_of(row: (Int, String)) -> String
    (_, content) = row
    content
  end

  priv fn relate(conn: Connection, from: String, to: String, kind: String)
    -> Connection ! String

    (conn, created) = RelationStore.create(conn, from, to, kind)

    match created
      Result.Err(e) -> fail "relate #{from} #{kind} #{to}: " <> e.message()
      Result.Ok(_) -> conn
    end
  end

  priv fn required(found: Result<Option<Entity>, Error>, name: String)
    -> Entity ! String

    match found
      Result.Err(e) ->
        fail "find #{name}: " <> e.message()

      Result.Ok(maybe) ->
        match maybe
          Option.None -> fail "#{name} is missing"
          Option.Some(entity) -> entity
        end
    end
  end

  # A 768-dim unit vector along the given axis, as a pgvector literal.
  priv fn axis_vector(axis: Int) -> String
    parts: List<String> = List.new()

    for i in Range{start: 0, stop: 767}
      parts = parts.append(i == axis ? "1" : "0")
    end

    "[" <> String.join(parts, ",") <> "]"
  end

  priv fn connect -> Connection ! String
    config = DbConfig.new("127.0.0.1", 5435, "postgres", "remem")

    Connection.connect(config)
      rescue e -> fail "connect (is docker compose up?): " <> e.message()
  end

  priv fn cleanup(conn: Connection) -> Connection ! String
    (conn, outcome) = conn.query(
      "DELETE FROM entities WHERE name LIKE 'itest-%'",
    )

    match outcome
      Result.Err(e) -> fail "cleanup: " <> e.message()
      Result.Ok(_) -> conn
    end
  end
end
